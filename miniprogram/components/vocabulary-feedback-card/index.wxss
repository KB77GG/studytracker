.feedback-card {
  width: 100%;
  padding: 24rpx;
  border: 2rpx solid rgba(8, 127, 119, 0.16);
  border-radius: 18rpx;
  background: #f5fbfa;
  color: #202637;
  text-align: left;
  box-sizing: border-box;
}

.feedback-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 18rpx;
}

.word-identity {
  min-width: 0;
  flex: 1 1 300rpx;
}

.feedback-word,
.feedback-syllables,
.feedback-phonetic,
.feedback-label,
.feedback-value,
.example-zh {
  display: block;
}

.feedback-word {
  color: #202637;
  font-size: 38rpx;
  line-height: 1.2;
  font-weight: 700;
  overflow-wrap: anywhere;
}

.feedback-syllables {
  margin-top: 6rpx;
  color: #52706d;
  font-size: 23rpx;
  letter-spacing: .04em;
}

.feedback-phonetic {
  margin-top: 6rpx;
  color: #788298;
  font-size: 25rpx;
}

.replay-button {
  min-height: 88rpx;
  margin: 0;
  padding: 0 20rpx;
  border: 2rpx solid rgba(8, 127, 119, 0.36);
  border-radius: 999rpx;
  background: #fff;
  color: #087f77;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 24rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.replay-button::after {
  border: 0;
}

.replay-button.state-loading {
  color: #637875;
  border-color: #c8dcda;
}

.replay-button.state-playing {
  background: #e8f7f4;
}

.replay-icon {
  width: 32rpx;
  height: 32rpx;
}

.feedback-section {
  margin-top: 22rpx;
}

.feedback-label {
  margin-bottom: 8rpx;
  color: #087f77;
  font-size: 23rpx;
  line-height: 1.3;
  font-weight: 650;
}

.feedback-value {
  color: #30394d;
  font-size: 28rpx;
  line-height: 1.6;
  overflow-wrap: anywhere;
}

.meaning-value {
  font-size: 30rpx;
  font-weight: 600;
}

.example-section {
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  background: #fff;
}

.example-en {
  color: #202637;
}

.example-zh {
  margin-top: 10rpx;
  color: #788298;
  font-size: 26rpx;
  line-height: 1.55;
  overflow-wrap: anywhere;
}

.note-section {
  padding-top: 18rpx;
  border-top: 2rpx solid rgba(8, 127, 119, 0.1);
}
