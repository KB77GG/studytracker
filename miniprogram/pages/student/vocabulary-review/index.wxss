.review-page { min-height: 100vh; padding: 48rpx 32rpx; box-sizing: border-box; background: #f5f7fb; color: #202637; }
.loading, .error, .empty, .summary { min-height: 70vh; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 24rpx; text-align: center; }
.error { color: #b43b35; }
.empty-icon { width: 112rpx; height: 112rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #e8f7ed; color: #26924b; font-size: 64rpx; }
.empty-title, .summary-title { font-size: 38rpx; font-weight: 700; }
.empty-desc, .summary-desc { color: #788298; line-height: 1.6; }
.header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 28rpx; }
.header-title { font-size: 42rpx; font-weight: 700; }
.progress, .dimension, .mode { color: #788298; font-size: 25rpx; }
.card { min-height: 620rpx; padding: 42rpx 32rpx; border-radius: 28rpx; background: #fff; box-shadow: 0 12rpx 40rpx rgba(31, 45, 75, .08); display: flex; flex-direction: column; align-items: center; gap: 28rpx; box-sizing: border-box; }
.dimension { align-self: flex-start; color: #ea6a35; }
.prompt-word, .prompt-meaning { max-width: 100%; text-align: center; font-size: 52rpx; font-weight: 700; overflow-wrap: anywhere; }
.prompt-text, .sentence, .target-word, .translation { width: 100%; line-height: 1.65; text-align: left; }
.sentence { padding: 26rpx; border-radius: 18rpx; background: #f6f8fc; font-size: 32rpx; }
.target-word { font-size: 34rpx; font-weight: 700; color: #343d52; }
.translation { color: #788298; }
.translation-block { width: 100%; padding: 18rpx 20rpx; border-radius: 14rpx; background: #fff8f3; box-sizing: border-box; }
.translation-label { display: block; margin-bottom: 6rpx; color: #c75524; font-size: 23rpx; font-weight: 600; }
.audio-btn { border: 2rpx solid #e46b37; border-radius: 999rpx; background: #fff7f2; color: #d85520; }
.answer-input { width: 100%; padding: 22rpx; border: 2rpx solid #dfe4ee; border-radius: 16rpx; box-sizing: border-box; font-size: 32rpx; }
.options { width: 100%; display: flex; flex-direction: column; gap: 16rpx; }
.option { padding: 24rpx; border: 2rpx solid #e0e5ee; border-radius: 16rpx; color: #3f4a61; }
.option.selected { border-color: #e46b37; background: #fff2ea; color: #c34b1b; }
.result { width: 100%; padding: 24rpx; border-radius: 16rpx; display: flex; flex-direction: column; gap: 10rpx; box-sizing: border-box; }
.result.correct { background: #eaf8ef; color: #218647; }
.result.wrong { background: #fff0ef; color: #b43b35; }
.submitted, .correct-answer { color: #4f5a70; font-size: 27rpx; }
.primary-btn, .secondary-btn { width: 100%; margin-top: 28rpx; border-radius: 999rpx; }
.strict-keyboard-wrap { width: 100%; margin-top: 24rpx; }
.primary-btn { background: #e46b37; color: #fff; }
.secondary-btn { background: #fff; color: #5f6b82; border: 2rpx solid #dfe4ee; }
.summary-score { font-size: 64rpx; font-weight: 700; color: #e46b37; }
