.learning-page { min-height: 100vh; padding: 36rpx 30rpx 56rpx; box-sizing: border-box; background: #f5f7fb; color: #202637; }
.loading, .error-panel, .summary-panel { min-height: 70vh; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 24rpx; text-align: center; }
.error-panel { color: #b43b35; }
.topbar { display: flex; align-items: flex-end; justify-content: space-between; gap: 18rpx; margin-bottom: 20rpx; }
.eyebrow { display: block; color: #788298; font-size: 24rpx; margin-bottom: 8rpx; }
.group-title { display: block; font-size: 42rpx; font-weight: 700; }
.word-total { color: #788298; font-size: 25rpx; white-space: nowrap; }
.phase-strip { display: flex; justify-content: space-between; gap: 12rpx; margin-bottom: 24rpx; padding: 18rpx 22rpx; border-radius: 16rpx; background: #fff3eb; color: #c75524; font-size: 26rpx; }
.card { padding: 34rpx 28rpx; border-radius: 26rpx; background: #fff; box-shadow: 0 12rpx 40rpx rgba(31, 45, 75, .08); box-sizing: border-box; }
.familiarity-card { min-height: 620rpx; display: flex; flex-direction: column; align-items: center; }
.familiarity-progress { width: 100%; display: flex; justify-content: space-between; color: #788298; font-size: 24rpx; }
.familiar-word, .prompt-word { max-width: 100%; margin-top: 58rpx; text-align: center; font-size: 54rpx; font-weight: 700; overflow-wrap: anywhere; }
.phonetic { margin-top: 12rpx; color: #788298; font-size: 27rpx; }
.meaning, .prompt-meaning { margin-top: 24rpx; text-align: center; font-size: 36rpx; font-weight: 600; overflow-wrap: anywhere; }
.audio-btn { margin: 24rpx 0 8rpx; border: 2rpx solid #e46b37; border-radius: 999rpx; background: #fff7f2; color: #d85520; font-size: 27rpx; }
.material-label { align-self: flex-start; margin-top: 20rpx; color: #788298; font-size: 24rpx; }
.material-text { width: 100%; margin-top: 8rpx; line-height: 1.65; font-size: 29rpx; overflow-wrap: anywhere; }
.translation { color: #788298; }
.translation-block { width: 100%; padding: 18rpx 20rpx; border-radius: 14rpx; background: #fff8f3; box-sizing: border-box; }
.translation-label { display: block; margin-bottom: 6rpx; color: #c75524; font-size: 23rpx; font-weight: 600; }
.navigation-row { display: flex; gap: 18rpx; margin-top: 24rpx; }
.navigation-row button { flex: 1; min-width: 0; }
.question-card { min-height: 430rpx; display: flex; flex-direction: column; align-items: center; gap: 20rpx; }
.question-kind, .mode-copy, .hint { color: #788298; font-size: 25rpx; }
.prompt-copy, .target-word, .sentence, .translation { width: 100%; line-height: 1.65; text-align: left; }
.target-word { color: #343d52; font-size: 31rpx; font-weight: 600; }
.sentence { padding: 22rpx; border-radius: 16rpx; background: #f6f8fc; font-size: 30rpx; box-sizing: border-box; overflow-wrap: anywhere; }
.options { width: 100%; display: flex; flex-direction: column; gap: 14rpx; }
.option { padding: 22rpx; border: 2rpx solid #e0e5ee; border-radius: 16rpx; color: #3f4a61; line-height: 1.45; overflow-wrap: anywhere; }
.option.selected { border-color: #e46b37; background: #fff2ea; color: #c34b1b; }
.answer-input { width: 100%; padding: 20rpx; border: 2rpx solid #dfe4ee; border-radius: 16rpx; box-sizing: border-box; font-size: 31rpx; }
.strict-keyboard-wrap { width: 100%; margin-top: 20rpx; }
.result { width: 100%; padding: 22rpx; border-radius: 16rpx; display: flex; flex-direction: column; gap: 8rpx; box-sizing: border-box; }
.result.correct { background: #eaf8ef; color: #218647; }
.result.wrong { background: #fff0ef; color: #b43b35; }
.result-line { color: #4f5a70; font-size: 26rpx; overflow-wrap: anywhere; }
.primary-btn, .secondary-btn { flex: 1; width: 100%; margin-top: 24rpx; border-radius: 999rpx; box-sizing: border-box; }
.primary-btn { background: #e46b37; color: #fff; }
.secondary-btn { background: #fff; color: #5f6b82; border: 2rpx solid #dfe4ee; }
.answer-btn { margin-top: 24rpx; }
.hint { display: block; margin: 20rpx 4rpx 0; text-align: center; line-height: 1.5; }
.summary-title { font-size: 40rpx; font-weight: 700; }
.summary-score { font-size: 72rpx; font-weight: 700; color: #e46b37; }
.summary-copy { max-width: 620rpx; color: #788298; line-height: 1.6; }
@media (max-width: 360px) {
  .learning-page { padding-left: 22rpx; padding-right: 22rpx; }
  .group-title { font-size: 36rpx; }
  .familiar-word, .prompt-word { font-size: 46rpx; }
  .card { padding-left: 22rpx; padding-right: 22rpx; }
}
