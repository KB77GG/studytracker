# 复制为 tools/ielts_writing_ai/.env 后修改（.env 已被 git 忽略，不要提交）。
# 试用工具只读取 IWA_ 开头的变量，不读主应用的 DEEPSEEK_API_KEY / ALIYUN_API_KEY。

# ---- 运行 ----
IWA_HOST=127.0.0.1
IWA_PORT=5055
# 数据目录：独立的 SQLite 库、上传题图、日志、PID、会话密钥都放这里
# IWA_DATA_DIR=/absolute/path/to/iwa-data
# 同一数据库只允许一个实例；等待上一个进程退出的秒数
# IWA_LOCK_WAIT=5
# 部署在 HTTPS 反向代理后面时打开：
# IWA_COOKIE_SECURE=1
# IWA_TRUST_PROXY=1
# IWA_URL_PREFIX=/writing-trial

# ---- 文本模型 ----
# fake = 演示模式（离线固定示例，不调用任何 API）；deepseek / qwen / openai_compatible
IWA_LLM_PROVIDER=fake
# IWA_LLM_API_KEY=
# IWA_LLM_MODEL=deepseek-chat
# IWA_LLM_BASE_URL=https://api.deepseek.com/v1/chat/completions
# IWA_LLM_TIMEOUT=120

# ---- 识图模型（Task 1 题图，可选）----
# none = 不识图（题图只保存展示，评价会提示未核对图表数据）；qwen / openai_compatible / fake
IWA_VISION_PROVIDER=none
# IWA_VISION_MODEL=qwen-vl-max-latest
# 识图 Key 不填时沿用 IWA_LLM_API_KEY（注意：本文件不支持行尾注释）
# IWA_VISION_API_KEY=

# ---- 成本控制 ----
# 每人每天生成次数（一次批改 = 3 次，重新生成 = 1 次）
IWA_DAILY_LIMIT=30
# 同时进行的模型调用数
IWA_MAX_WORKERS=2
IWA_MAX_UPLOAD_MB=5
