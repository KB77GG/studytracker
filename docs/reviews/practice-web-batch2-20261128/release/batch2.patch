+            source_updated_at_label="合成导航样例",
+            next_update_label="",
+        )
+        return view
+
+    return navigation_fixture
+
+
+def self_test(app):
+    """Read-only local GETs; no browser, server, credentials, or network."""
+    client = app.test_client()
+    sprint = client.get("/practice/sprint/reading")
