+        ),
+    }
+    print(json.dumps({"ok": all(checks.values()), "checks": checks}, indent=2))
+    return 0 if all(checks.values()) else 1
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("root", type=Path)
