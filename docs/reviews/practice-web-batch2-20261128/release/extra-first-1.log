ong {\n  display: block;\n  color: var(--lw-neutral-900);\n  font-family: var(--lw-font-en);\n  font-size: 34px;\n  font-weight: 800;\n  letter-spacing: -.04em;\n  line-height: 1;\n}\n.practice-workspace__test-copy { min-width: 0; }\n.practice-workspace__test-copy strong {\n  display: block;\n  color: var(--lw-neutral-800);\n  font-size: 14px;\n  font-weight: 700;\n}\n.practice-workspace__test-copy small {\n  display: block;\n  margin-top: 6px;\n  color: var(--lw-neutral-500);\n  font-size: 13px;\n  line-height: 1.5;\n}\n.practice-workspace__test-action {\n  min-height: 42px;\n  padding: 8px 20px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  border: 1.5px solid var(--lw-green-200);\n  border-radius: 999px;\n  color: var(--lw-green-600);\n  font-size: 14px;\n  font-weight: 800;\n  text-decoration: none;\n  white-space: nowrap;\n}\n.practice-workspace__test-card:not(.is-done) > .practice-workspace__test-summary > .practice-workspace__test-action {\n  border-color: var(--lw-green-400);\n  background: var(--lw-green-400);\n  color: #fff;\n}\n.practice-workspace__test-card--flat .practice-workspace__test-summary { cursor: default; }\n.practice-workspace__flat-actions {\n  display: flex;\n  align-items: center;\n  justify-content: flex-end;\n  gap: 8px;\n}\n.practice-workspace__flat-actions .practice-workspace__test-action.is-primary {\n  border-color: var(--lw-green-400);\n  background: var(--lw-green-400);\n  color: #fff;\n}\n.practice-workspace__flat-actions .practice-workspace__test-action:hover {\n  border-color: var(--lw-green-400);\n  background: var(--lw-green-50);\n}\n.practice-workspace__flat-actions .practice-workspace__test-action.is-primary:hover {\n  background: var(--lw-green-500);\n  color: #fff;\n}\n.practice-workspace__flat-actions .practice-workspace__test-action[hidden] { display: none; }\n.practice-workspace__test-card--jijing .practice-workspace__test-summary {\n  min-height: 86px;\n  cursor: default;\n}\n.practice-workspace__jijing-count {\n  color: var(--lw-neutral-500);\n  font-family: var(--lw-font-en);\n  font-size: 12px;\n  font-weight: 700;\n  white-space: nowrap;\n}\n.practice-workspace__jijing-parts {\n  padding: 0 20px 20px;\n  display: grid;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  gap: 8px;\n}\n.practice-workspace__jijing-part {\n  min-width: 0;\n  min-height: 72px;\n  padding: 11px 12px;\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n  gap: 4px;\n  border: 1px solid var(--lw-neutral-200);\n  border-radius: 8px;\n  background: #fff;\n  color: var(--lw-neutral-700);\n  text-decoration: none;\n}\n.practice-workspace__jijing-part:hover {\n  border-color: var(--lw-green-200);\n  background: var(--lw-green-50);\n  color: var(--lw-green-700);\n}\n.practice-workspace__jijing-part.is-done {\n  border-color: rgba(47, 142, 135, .35);\n  background: var(--lw-green-50);\n}\n.practice-workspace__jijing-part strong {\n  color: var(--lw-neutral-800);\n  font-size: 12px;\n  font-weight: 800;\n}\n.practice-workspace__jijing-part span,\n.practice-workspace__jijing-part small {\n  overflow-wrap: anywhere;\n  color: var(--lw-neutral-500);\n  font-size: 11px;\n  line-height: 1.35;\n}\n.practice-workspace__jijing-part small {\n  color: var(--lw-green-600);\n  font-weight: 800;\n}\n.practice-workspace__test-panel {\n  margin: 0 18px 18px;\n  padding: 12px;\n  display: grid;\n  grid-template-columns: 150px minmax(0, 1fr);\n  gap: 10px;\n  border: 1px solid var(--lw-green-200);\n  border-radius: 10px;\n  background: var(--lw-green-50);\n}\n.practice-workspace__full-practice {\n  min-height: 76px;\n  padding: 12px 14px;\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  justify-content: center;\n  gap: 2px;\n  border: 1px solid var(--lw-green-400);\n  border-radius: 8px;\n  background: var(--lw-green-400);\n  color: #fff;\n}\n.practice-workspace__full-practice:hover { background: var(--lw-green-500); }\n.practice-workspace__full-practice small { opacity: .85; font-size: 11px; }\n.practice-workspace__parts {\n  display: grid;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  gap: 8px;\n}\n.practice-workspace__part {\n  min-width: 0;\n  padding: 9px 10px;\n  border: 1px solid var(--lw-neutral-200);\n  border-radius: 8px;\n  background: #fff;\n}\n.practice-workspace__part > strong {\n  display: block;\n  margin-bottom: 7px;\n  color: var(--lw-neutral-800);\n  font-family: var(--lw-font-en);\n  font-size: 11px;\n}\n.practice-workspace__part > span { display: flex; gap: 4px; }\n.practice-workspace__part a {\n  min-width: 0;\n  min-height: 30px;\n  padding: 4px 6px;\n  display: inline-flex;\n  flex: 1;\n  align-items: center;\n  justify-content: center;\n  border: 1px solid var(--lw-neutral-200);\n  border-radius: 5px;\n  background: #fff;\n  color: var(--lw-neutral-700);\n  font-size: 11px;\n  font-weight: 800;\n}\n.practice-workspace__part a:hover {\n  border-color: var(--lw-green-200);\n  background: var(--lw-green-50);\n  color: var(--lw-green-700);\n}\n.practice-workspace__empty {\n  padding: 32px;\n  border: 1px dashed var(--lw-neutral-200);\n  border-radius: 14px;\n  background: #fff;\n  color: var(--lw-neutral-500);\n  text-align: center;\n}\n.practice-workspace__scrim { display: none; }\n\n@media (max-width: 1080px) {\n  .practice-workspace__main { padding-right: 28px; padding-left: 28px; }\n  .practice-workspace__page-heading > div:first-child > div {\n    flex-direction: column;\n    align-items: flex-start;\n    gap: 5px;\n  }\n  .practice-workspace__parts { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n  .practice-workspace__jijing-parts { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n}\n\n@media (max-width: 860px) {\n  .practice-workspace__topbar { padding: 0 18px; }\n  .practice-workspace__brand span { display: none; }\n  .practice-workspace__brand-nav { gap: 18px; }\n  .practice-workspace__subjects { gap: 6px; }\n  .practice-workspace__account a,\n  .practice-workspace__account button { display: none; }\n  .practice-workspace__account [data-practice-module-exit] {\n    min-height: 34px;\n    padding: 6px 9px;\n    display: inline-flex;\n    align-items: center;\n    border: 1px solid var(--lw-neutral-200);\n    border-radius: 999px;\n    background: #fff;\n    font-size: 11px;\n  }\n  .practice-workspace__layout { grid-template-columns: 1fr; min-height: calc(100vh - 60px); }\n  .practice-workspace__sidebar {\n    position: fixed;\n    inset: 0 auto 0 0;\n    z-index: 70;\n    width: min(86vw, 320px);\n    height: 100vh;\n    border-right: 0;\n    box-shadow: 18px 0 54px rgba(0, 0, 0, .18);\n    transform: translateX(-105%);\n    transition: transform .2s ease;\n  }\n  .practice-workspace__sidebar.is-open { transform: translateX(0); }\n  .practice-workspace__sidebar-head {\n    margin-bottom: 14px;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n  }\n  .practice-workspace__sidebar-head strong { font-size: 16px; }\n  .practice-workspace__sidebar-head button {\n    min-height: 40px;\n    padding: 0 12px;\n    border: 0;\n    border-radius: 999px;\n    background: var(--lw-neutral-100);\n    color: var(--lw-neutral-700);\n    cursor: pointer;\n    font-weight: 700;\n  }\n  .practice-workspace__scrim {\n    position: fixed;\n    inset: 0;\n    z-index: 60;\n    display: block;\n    border: 0;\n    background: rgba(28, 28, 28, .32);\n  }\n  .practice-workspace__scrim[hidden] { display: none; }\n  .practice-workspace__main { padding: 24px 22px 42px; }\n  .practice-workspace__page-watermark { top: 4px; right: 18px; font-size: 52px; opacity: .42; }\n  .practice-workspace__catalog-button {\n    min-height: 42px;\n    margin-bottom: 18px;\n    padding: 8px 14px;\n    display: inline-flex;\n    align-items: center;\n    border: 1px solid var(--lw-green-200);\n    border-radius: 999px;\n    background: #fff;\n    color: var(--lw-green-700);\n    cursor: pointer;\n    font-weight: 800;\n  }\n  .practice-workspace__page-heading { align-items: flex-end; }\n  .practice-workspace__book-progress { flex-direction: column; align-items: flex-end; gap: 6px; }\n  .practice-workspace__book-progress > span:first-child { display: none; }\n  .practice-workspace__progress-track { width: 120px; }\n}\n\n@media (max-width: 640px) {\n  .practice-workspace__topbar { height: 56px; padding-right: 14px; padding-left: 14px; gap: 12px; }\n  .practice-workspace__brand-nav { gap: 8px; }\n  .practice-workspace__subjects { gap: 4px; }\n  .practice-workspace__context { display: none; }\n  .practice-workspace__subjects a { min-width: 48px; padding: 0 6px; font-size: 15px; }\n  .practice-workspace__layout { min-height: calc(100vh - 56px); }\n  .practice-workspace__main { padding: 20px 14px 36px; }\n  .practice-workspace__page-watermark { display: none; }\n  .practice-workspace__page-heading { align-items: flex-start; flex-direction: column; gap: 14px; }\n  .practice-workspace__page-heading h1,\n.practice-workspace__page-heading h2 { font-size: 27px; }\n  .practice-workspace__book-progress { width: 100%; flex-direction: row; align-items: center; }\n  .practice-workspace__book-progress > span:first-child { display: block; }\n  .practice-workspace__progress-track { flex: 1; width: auto; }\n  .practice-workspace__continue { padding: 16px; align-items: flex-start; flex-direction: column; }\n  .practice-workspace__continue p { line-height: 1.55; }\n  .practice-workspace__continue > div:last-child { width: 100%; }\n  .practice-workspace__continue a { flex: 1; }\n  .practice-workspace__test-summary {\n    min-height: 0;\n    padding: 18px;\n    grid-template-columns: 58px minmax(0, 1fr);\n    gap: 14px;\n  }\n  .practice-workspace__test-number strong { font-size: 29px; }\n  .practice-workspace__test-action { grid-column: 1 / -1; }\n  .practice-workspace__test-card:not(.is-done) > .practice-workspace__test-summary > .practice-workspace__test-action { width: 100%; }\n  .practice-workspace__flat-actions {\n    width: 100%;\n    grid-column: 1 / -1;\n  }\n  .practice-workspace__flat-actions .practice-workspace__test-action { flex: 1; }\n  .practice-workspace__test-card--jijing .practice-workspace__test-summary {\n    grid-template-columns: 52px minmax(0, 1fr);\n  }\n  .practice-workspace__jijing-count { grid-column: 2; }\n  .practice-workspace__jijing-parts { padding: 0 12px 12px; grid-template-columns: 1fr; }\n  .practice-workspace__test-panel { margin: 0 10px 10px; grid-template-columns: 1fr; }\n  .practice-workspace__full-practice { min-height: 48px; align-items: center; }\n  .practice-workspace__parts { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .practice-workspace-page *,\n  .practice-workspace-page *::before,\n  .practice-workspace-page *::after {\n    scroll-behavior: auto !important;\n    transition-duration: .01ms !important;\n  }\n}\n/* Shared navigation remains available at narrow widths. Catalog visuals stay unchanged. */\n.practice-workspace__title { margin: 0 0 20px; font-size: 24px; line-height: 1.3; }\n[data-practice-workspace-header] [hidden] { display: none !important; }\n[data-practice-workspace-header] .practice-workspace__identity {\n  max-width: 180px; padding: 7px 10px; border-radius: 999px;\n  background: var(--lw-green-50); color: var(--lw-green-600);\n  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;\n}\n[data-practice-workspace-header] .practice-workspace__subjects a { white-space: nowrap; }\n[data-practice-workspace-header] .practice-workspace__account { min-width: 0; }\n@media (max-width: 1180px) {\n  [data-practice-workspace-header] { position: relative; height: auto; min-height: 60px; flex-wrap: wrap; gap: 8px; padding-top: 10px; padding-bottom: 10px; }\n  [data-practice-workspace-header] .practice-workspace__brand-nav { width: 100%; flex-wrap: wrap; gap: 12px; }\n  [data-practice-workspace-header] .practice-workspace__brand span { display: inline; }\n  [data-practice-workspace-header] .practice-workspace__subjects { flex-wrap: wrap; gap: 4px; min-height: 36px; }\n  [data-practice-workspace-header] .practice-workspace__subjects a { min-height: 36px; }\n  [data-practice-workspace-header] .practice-workspace__account { width: 100%; height: auto; flex-wrap: wrap; gap: 10px; }\n  [data-practice-workspace-header] .practice-workspace__account a,\n  [data-practice-workspace-header] .practice-workspace__account button { display: inline-flex; align-items: center; min-height: 32px; }\n}\n@media (max-width: 520px) {\n  [data-practice-workspace-header] .practice-workspace__subjects { width: 100%; justify-content: space-between; }\n  [data-practice-workspace-header] .practice-workspace__subjects a { min-width: 0; padding: 0 5px; font-size: 13px; }\n}\n</style>\n<link href="/static/css/exam_sprint.css" rel="stylesheet">\n</head>\n<body class="practice-workspace-page" data-practice-hub="section">\n<div class="practice-workspace" data-practice-workspace>\n  \n\n\n\n\n<header class="practice-workspace__topbar" data-practice-workspace-header>\n  <div class="practice-workspace__brand-nav">\n    <a class="practice-workspace__brand" href="/practice" data-practice-home aria-label="Sage Path 练习中心">\n      <img src="/static/brand/sagepath-mark.png" alt="">\n      <span>Sage Path</span>\n    </a>\n    <nav class="practice-workspace__subjects" aria-label="练习导航">\n      \n      <a href="/practice" data-practice-nav>练习中心</a>\n      \n      <a href="/listening/tests" data-practice-nav class="is-active" aria-current="page">听力</a>\n      \n      <a href="/reading/tests" data-practice-nav>阅读</a>\n      \n      <a href="/writing/" data-practice-nav>写作</a>\n      \n      <a href="/practice/question-types" data-practice-nav>题型专项</a>\n      \n    </nav>\n  </div>\n  <div class="practice-workspace__account">\n    \n    <a href="/practice" data-practice-module-back>返回练习中心</a>\n    \n    <a class="practice-workspace__identity" href="/practice#practiceIde