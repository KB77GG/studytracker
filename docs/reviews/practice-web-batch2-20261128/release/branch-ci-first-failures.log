account-provisioning	Test web vocabulary identity, shared settlement and task integration	2026-11-28T04:10:02.9955011Z AssertionError: 'task.status_label || task.task_status_label || task.availability_label' not found in '{% set practice_navigation = practice_navigation|default({\n  \'identity_mode\': \'guest\',\n  \'module_root_url\': \'/practice\',\n  \'module_exit_url\': \'/login\',\n  \'module_exit_label\': \'退出刷题\'\n}, true) %}\n<!DOCTYPE html>\n<html lang="zh">\n<head>\n<meta charset="utf-8">\n<meta name="viewport" content="width=device-width, initial-scale=1">\n<title>精听练习 · Sage Path</title>\n<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">\n<link href="{{ url_for(\'static\', filename=\'style.css\') }}" rel="stylesheet">\n<style>\n/* listening/index 局部样式 — 颜色全部走全局 token，不再硬编码 */\n.listening-page { max-width: 960px; margin: 0 auto; padding: 32px 24px 48px; background: transparent; box-shadow: none; border-radius: 0; }\n\n/* 顶部学生/员工身份小条 —— 浮在右上角 */\n.identity-bar {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  padding: 8px 14px;\n  background: var(--brand-soft);\n  border: 1px solid var(--brand-light);\n  border-radius: var(--r-pill);\n  margin-bottom: 18px;\n  font-size: var(--fs-sm);\n  color: var(--brand-dark);\n}\n.identity-bar.identity-bar--staff {\n  background: var(--success-soft);\n  border-color: rgba(22,163,74,.28);\n  color: var(--success);\n}\n.identity-bar .name { font-weight: 700; }\n.identity-bar .actions { display: flex; gap: 14px; align-items: center; }\n.identity-bar .actions a,\n.identity-bar .actions button {\n  background: none;\n  border: none;\n  padding: 0;\n  font-size: var(--fs-sm);\n  color: inherit;\n  text-decoration: none;\n  cursor: pointer;\n  font-weight: 600;\n  opacity: .82;\n}\n.identity-bar .actions a:hover,\n.identity-bar .actions button:hover { opacity: 1; text-decoration: underline; }\n\n/* 操作按钮 */\n.upload-btn {\n  display: inline-flex;\n  align-items: center;\n  height: 38px;\n  padding: 0 16px;\n  background: var(--brand);\n  color: #fff;\n  border-radius: var(--r-sm);\n  text-decoration: none;\n  font-size: var(--fs-base);\n  font-weight: 600;\n  transition: background .15s ease;\n}\n.upload-btn:hover { background: var(--brand-dark); }\n\n/* 页面标题区 —— mode-nav 提到最顶 */\n.page-intro {\n  display: flex;\n  align-items: flex-end;\n  justify-content: space-between;\n  gap: 16px;\n  margin: 4px 0 24px;\n}\n.page-intro .subtitle { color: var(--muted); margin: 0; font-size: var(--fs-base); max-width: 560px; }\n\n/* 卡片网格 */\n.exercise-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));\n  gap: 16px;\n}\n.exercise-card {\n  background: #fff;\n  border-radius: var(--r);\n  padding: 20px;\n  border: 1px solid var(--line);\n  text-decoration: none;\n  color: inherit;\n  transition: border-color .15s ease, box-shadow .2s ease, transform .2s ease;\n  display: flex;\n  flex-direction: column;\n  gap: 14px;\n}\n.exercise-card:hover {\n  border-color: var(--brand-light);\n  box-shadow: var(--shadow-md);\n  transform: translateY(-2px);\n}\n.exercise-card.exercise-card--link { cursor: pointer; }\n.exercise-card__head { display: flex; flex-direction: column; gap: 4px; }\n.exercise-card__head h3 { font-size: var(--fs-md); margin: 0; color: var(--text-strong); line-height: 1.35; }\n.exercise-card__meta { font-size: var(--fs-sm); color: var(--muted); }\n\n/* 学生进度条 */\n.progress-row { display: flex; flex-direction: column; gap: 6px; }\n.progress-track {\n  height: 6px;\n  background: var(--brand-tint);\n  border-radius: var(--r-pill);\n  overflow: hidden;\n}\n.progress-fill {\n  height: 100%;\n  background: var(--brand);\n  border-radius: var(--r-pill);\n  width: 0%;\n  transition: width .3s ease;\n}\n.progress-label {\n  font-size: var(--fs-sm);\n  color: var(--brand-dark);\n  font-weight: 600;\n}\n.progress-label.muted { color: var(--muted); font-weight: 500; }\n\n/* 员工 stats —— 砍到 2 个 */\n.exercise-stats {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 8px;\n}\n.exercise-stat {\n  background: var(--brand-tint);\n  border-radius: var(--r-sm);\n  padding: 10px 12px;\n}\n.exercise-stat .k {\n  display: block;\n  font-size: var(--fs-xs);\n  color: var(--muted);\n}\n.exercise-stat .v {\n  display: block;\n  margin-top: 4px;\n  font-size: var(--fs-md);\n  color: var(--text-strong);\n  font-weight: 700;\n}\n\n/* 操作行 */\n.exercise-actions {\n  display: flex;\n  gap: 8px;\n  margin-top: auto;\n}\n.exercise-actions .action-btn {\n  flex: 1;\n  text-align: center;\n  border-radius: var(--r-sm);\n  padding: 9px 10px;\n  text-decoration: none;\n  font-size: var(--fs-sm);\n  font-weight: 600;\n  cursor: pointer;\n  border: 1px solid transparent;\n  background: transparent;\n  transition: background .15s ease, color .15s ease;\n}\n.action-open { background: var(--brand); color: #fff; }\n.action-open:hover { background: var(--brand-dark); }\n.action-assign { background: var(--brand-tint); color: var(--brand-dark); border-color: var(--brand-light); }\n.action-assign:hover { background: var(--brand-soft); }\n.action-danger { background: var(--danger-soft); color: var(--danger); border-color: var(--danger-line); flex: 0 0 auto; padding: 9px 12px; }\n.action-danger:hover:not(:disabled) { background: var(--danger-tint); }\n.action-danger:disabled { opacity: .5; cursor: not-allowed; }\n\n/* 学生 CTA */\n.student-cta {\n  margin-top: auto;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  height: 38px;\n  border-radius: var(--r-sm);\n  background: var(--brand);\n  color: #fff;\n  font-size: var(--fs-sm);\n  font-weight: 600;\n  text-decoration: none;\n  transition: background .15s ease;\n}\n.student-cta:hover { background: var(--brand-dark); }\n\n/* 空状态 */\n.empty-state {\n  text-align: center;\n  padding: 60px 20px;\n  background: #fff;\n  border: 1px dashed var(--line-strong);\n  border-radius: var(--r);\n  color: var(--muted);\n}\n.empty-state h3 { margin: 0 0 8px; color: var(--text-strong); font-size: var(--fs-lg); }\n.empty-state p { margin: 0 0 20px; font-size: var(--fs-base); }\n\n/* 学生姓名验证 gate */\n.login-gate {\n  max-width: 420px;\n  margin: 60px auto;\n  text-align: center;\n}\n.login-gate .eyebrow {\n  margin: 0 0 8px;\n  color: var(--brand);\n  font-size: var(--fs-xs);\n  font-weight: 700;\n  letter-spacing: .12em;\n  text-transform: uppercase;\n}\n.login-gate h1 { font-size: var(--fs-xl); margin: 0 0 8px; color: var(--text-strong); }\n.login-gate .desc { color: var(--muted); margin: 0 0 24px; font-size: var(--fs-base); }\n.login-gate .form-card {\n  background: #fff;\n  border-radius: var(--r);\n  padding: 28px;\n  border: 1px solid var(--line);\n  box-shadow: var(--shadow-md);\n  text-align: left;\n}\n.login-gate label {\n  display: block;\n  font-size: var(--fs-sm);\n  font-weight: 600;\n  margin-bottom: 8px;\n  color: var(--text);\n}\n.login-gate input {\n  width: 100%;\n  padding: 12px 14px;\n  border: 1px solid var(--line-strong);\n  border-radius: var(--r-sm);\n  font-size: var(--fs-md);\n  margin-bottom: 14px;\n  transition: border-color .15s ease, box-shadow .15s ease;\n}\n.login-gate input:focus {\n  outline: none;\n  border-color: var(--brand);\n  box-shadow: var(--focus-ring);\n}\n.login-gate .btn {\n  display: block;\n  width: 100%;\n  padding: 13px;\n  background: var(--brand);\n  color: #fff;\n  border: none;\n  border-radius: var(--r-sm);\n  font-size: var(--fs-md);\n  font-weight: 700;\n  cursor: pointer;\n  transition: background .15s ease;\n}\n.login-gate .btn:hover { background: var(--brand-dark); }\n.login-gate .form-help {\n  display: block;\n  margin-top: 12px;\n  font-size: var(--fs-sm);\n  color: var(--muted);\n  text-align: center;\n}\n.login-gate .error {\n  color: var(--danger);\n  font-size: var(--fs-sm);\n  margin-top: 12px;\n  display: none;\n  background: var(--danger-soft);\n  padding: 8px 10px;\n  border-radius: var(--r-sm);\n}\n.login-gate .staff-link {\n  display: inline-block;\n  margin-top: 24px;\n  color: var(--muted-soft);\n  font-size: var(--fs-xs);\n  text-decoration: none;\n}\n.login-gate .staff-link:hover { color: var(--muted); text-decoration: underline; }\n\n@media (max-width: 720px) {\n  .listening-page { padding: 22px 14px 40px; }\n}\n.listening-library.listening-library__page-title { padding-bottom: 0; }\n.auth-entry__heading #studentEntryTitle {\n  margin: 0; color: #10263f;\n  font-family: "Songti SC", "Noto Serif SC", STSong, SimSun, serif;\n  font-size: 40px; line-height: 1.25; font-weight: 700; letter-spacing: .02em;\n}\n@media (max-width: 720px) {\n  .auth-entry__heading #studentEntryTitle { font-size: 34px; }\n}\n</style>\n{% include "listening/_library_styles.html" %}\n{% include "practice/_workspace_styles.html" %}\n</head>\n{% set auth_gate_visible = not (staff_mode|default(show_upload)) %}\n<body class="practice-workspace-page {{ \'auth-entry-body\' if auth_gate_visible else \'\' }}" data-practice-hub="section">\n{% with workspace_active=\'listening\', workspace_intensive=true %}{% include "practice/_workspace_header.html" %}{% endwith %}\n<div class="listening-page listening-library listening-library__page-title"><h1 class="listening-library__title">精听练习</h1></div>\n\n{% macro render_intensive_catalog(catalog, staff=False, can_manage=False) %}\n{% set suffix = \'staff\' if staff else \'student\' %}\n<div class="listening-catalog-layout js-listening-catalog">\n  <aside class="listening-catalog-sidebar" aria-label="精听目录筛选">\n    <label class="listening-catalog-sidebar__label" for="listeningSearch-{{ suffix }}">搜索精听</label>\n    <input class="listening-catalog-sidebar__search js-listening-search"\n           id="listeningSearch-{{ suffix }}"\n           type="search"\n           placeholder="Book / Test / Section">\n    <div class="listening-catalog-sidebar__meta">\n      {{ catalog.book_count }} 本 · {{ catalog.test_count }} 套 Test · {{ catalog.section_count }} 个 Section\n    </div>\n    <nav class="listening-catalog-sidebar__links" aria-label="Cambridge IELTS 书籍索引">\n      {% for book in catalog.books %}\n      <a class="listening-catalog-sidebar__link" href="#listening-book-{{ book.series or \'cambridge\' }}-{{ book.book }}-{{ suffix }}">\n        <span>{% if book.series and book.series != \'cambridge\' %}{{ book.label or book.book }}{% else %}IELTS {{ book.book }}{% endif %}</span>\n        <span>{{ book.section_count }}</span>\n      </a>\n      {% endfor %}\n      {% if catalog.others %}\n      <a class="listening-catalog-sidebar__link" href="#listening-other-{{ suffix }}">\n        <span>其他</span>\n        <span>{{ catalog.others|length }}</span>\n      </a>\n      {% endif %}\n    </nav>\n  </aside>\n\n  <section class="listening-intensive-main">\n    <div class="listening-catalog-no-results">没有找到匹配的精听资源。</div>\n    {% for book in catalog.books %}\n    <article class="listening-intensive-book js-listening-book-group"\n             id="listening-book-{{ book.series or \'cambridge\' }}-{{ book.book }}-{{ suffix }}"\n             data-search="{{ book.search_terms or (\'ielts \' ~ book.book ~ \' cambridge \' ~ book.book ~ \' 剑\' ~ book.book) }}">\n      <header class="listening-intensive-book__header">\n        <div class="listening-intensive-book__title">\n          {% if book.series and book.series != \'cambridge\' %}\n          <span class="listening-intensive-book__label">{{ book.label or book.book }}</span>\n          {% else %}\n          <span class="listening-intensive-book__label">Cambridge IELTS</span>\n          <span class="listening-intensive-book__number">{{ book.book }}</span>\n          {% endif %}\n        </div>\n        <span class="listening-intensive-book__meta">{{ book.test_count }} Test · {{ book.section_count }} Section</span>\n      </header>\n      <div class="listening-intensive-test-grid">\n        {% for test in book.tests %}\n        <section class="listening-intensive-test js-listening-test-group"\n                 data-search="{{ test.title }} ielts{{ test.book }} test{{ test.test }} 剑{{ test.book }} test {{ test.test }}">\n          <div class="listening-intensive-test__head">\n            <div>\n              <h2 class="listening-intensive-test__title">Test {{ test.test }}</h2>\n              <div class="listening-intensive-test__meta">{{ test.section_count }} Section · {{ test.segment_count }} 个句子{% if test.last_assigned %} · 最近布置 {{ test.last_assigned }}{% endif %}</div>\n            </div>\n            {% if staff %}\n            <div class="listening-intensive-section__score">\n              {{ test.done_count }} / {{ test.task_count }} 完成\n            </div>\n            {% endif %}\n          </div>\n          <div class="listening-intensive-sections">\n            {% for section in test.sections %}\n            <div class="listening-intensive-section js-listening-section{% if not staff %} js-student-exercise-card{% endif %}"\n                 data-search="{{ section.title }} {{ section.id }} ielts{{ section.book }} test{{ section.test }} section{{ section.section }} s{{ section.section }}"\n                 {% if not staff %}\n                 data-exercise-id="{{ section.id }}"\n                 data-segment-count="{{ section.segment_count }}"\n                 data-href="{{ url_for(\'listening_player\', exercise_id=section.id) }}"\n                 {% endif %}>\n              <div class="listening-intensive-section__top">\n                <div>\n                  <a class="listening-intensive-section__link" href="{{ url_for(\'listening_player\', exercise_id=section.id) }}">Section {{ section.section }}</a>\n                  <div class="listening-intensive-section__meta">{{ section.segment_count }} 个句子{% if section.last_assigned %} · {{ section.last_assigned }}{% endif %}</div>\n                </div>\n                {% if staff %}\n                <span class="listening-intensive-section__score">{{ (\'%.1f%%\'|format(section.avg_accuracy)) if section.avg_accuracy is not none else \'—\' }}</span>\n                {% endif %}\n              </div>\n              {% if staff %}\n              <div class="listening-intensive-section__actions">\n                {% if can_manage %}\n                <a class="action-btn action-assign" href="{{ url_for(\'tasks_page\') }}?preset_exercise={{ section.id }}#taskForm">布置任务</a>\n                <button class="action-btn action-danger js-delete-exercise" data-id="{{ section.id }}" {% if section.task_count > 0 %}disabled title="已有任务引用，不能删除"{% endif %}>删除</button>\n                {% else %}\n                <a class="action-btn action-open" href="{{ url_for(\'listening_player\', exercise_id=section.id) }}">打开练习</a>\n                {% endif %}\n              </div>\n              {% else %}\n              <div class="progress-row">\n                <div class="progress-track"><div class="progress-fill"></div></div>\n                <div class="progress-label muted">尚未开始</div>\n              </div>\n              <a class="student-cta" href="{{ url_for(\'listening_player\', exercise_id=section.id) }}">开始练习</a>\n              {% endif %}\n            </div>\n            {% endfor %}\n          </div>\n        </section>\n        {% endfor %}\n      </div>\n    </article>\n    {% endfor %}\n\n    {% if catalog.others %}\n    <section class="listening-intensive-other js-listening-book-group" id="listening-other-{{ suffix }}" data-search="other custom 其他">\n      <h2 class="listening-intensive-other__title">其他精听</h2>\n      <div class="exercise-grid">\n        {% for ex in catalog.others %}\n        <div class="exercise-card{% if not staff %} js-student-exercise-card{% endif %} js-listening-section"\n             data-search="{{ ex.title }} {{ ex.id }}"\n             {% if not staff %}\n             data-exercise-id="{{ ex.id }}"\n             data-segment-count="{{ ex.segment_count }}"\n             data-href="{{ url_for(\'listening_player\', exercise_id=ex.id) }}"\n             {% endif %}>\n          <div class="exercise-card__head">\n            <h3>{{ ex.title }}</h3>\n            <div class="exercise-card__meta">{{ ex.segment_count }} 个句子{% if ex.last_assigned %} · 最近布置 {{ ex.last_assigned }}{% endif %}</div>\n          </div>\n          {% if staff %}\n          <div class="exercise-stats">\n            <div class="exercise-stat">\n              <span class="k">完成 / 布置</span>\n              <span class="v">{{ ex.done_count }} / {{ ex.task_count }}</span>\n            </div>\n            <div class="exercise-stat">\n              <span class="k">平均正确率</span>\n              <span class="v">{{ (\'%.1f%%\'|format(ex.avg_accuracy)) if ex.avg_accuracy is not none else \'—\' }}</span>\n            </div>\n          </div>\n          <div class="exercise-actions">\n            <a class="action-btn action-open" href="{{ url_for(\'listening_player\', exercise_id=ex.id) }}">打开练习</a>\n            {% if can_manage %}\n            <a class="action-btn action-assign" href="{{ url_for(\'tasks_page\') }}?preset_exercise={{ ex.id }}#taskForm">布置任务</a>\n            <button class="action-btn action-danger js-delete-exercise" data-id="{{ ex.id }}" {% if ex.task_count > 0 %}disabled title="已有任务引用，不能删除"{% endif %}>删除</button>\n            {% endif %}\n          </div>\n          {% else %}\n          <div class="progress-row">\n            <div class="progress-track"><div class="progress-fill"></div></div>\n            <div class="progress-label muted">尚未开始</div>\n          </div>\n          <a class="student-cta" href="{{ url_for(\'listening_player\', exercise_id=ex.id) }}">开始练习</a>\n          {% endif %}\n        </div>\n        {% endfor %}\n      </div>\n    </section>\n    {% endif %}\n  </section>\n</div>\n{% endmacro %}\n\n{% if staff_mode|default(show_upload) %}\n{# 已登录员工或课堂口令模式：跳过学生姓名验证，直接显示内容 #}\n<div class="listening-page listening-library" id="mainContent">\n\n\n  <div class="listening-library__header">\n    <div>\n      <p class="listening-library__eyebrow">听力 / 精听</p>\n      <p class="listening-library__summary">选择一个练习开始精听训练。学生自由练习会在当前浏览器自动保存进度。</p>\n    </div>\n    {% if show_upload %}\n    <div class="listening-library__actions">\n      <a class="listening-library__button listening-library__button--primary" href="{{ url_for(\'listening_upload\') }}">+ 上传新练习</a>\n    </div>\n    {% endif %}\n  </div>\n\n  <p><a href="{{ url_for(\'practice_library\') }}#practiceAssignedTasks" data-practice-nav>在练习中心查看任务与记录</a></p>\n\n  {% if exercises %}\n  {{ render_intensive_catalog(intensive_catalog, staff=True, can_manage=show_upload) }}\n  {% else %}\n  <div class="empty-state">\n    <h3>还没有精听练习</h3>\n    {% if show_upload %}\n    <p>上传一个音频和原文，几分钟就能让学生开始练习。</p>\n    <a class="listening-library__button listening-library__button--primary" href="{{ url_for(\'listening_upload\') }}">+ 上传新练习</a>\n    {% else %}\n    <p>暂时没有可用于课堂讲题的精听练习。</p>\n    {% endif %}\n  </div>\n  {% endif %}\n</div>\n\n{% else %}\n{# 未登录：学生姓名验证 #}\n\n{% from "auth/_entrance_shell.html" import entrance_shell %}\n<div id="loginGate">\n  {% call entrance_shell(\'studentEntryTitle\', \'auth-entry__panel-inner--student\', show_brandbar=false) %}\n  <div class="auth-entry__heading">\n    <h2 id="studentEntryTitle">确认学生身份</h2>\n    <p>输入老师登记的姓名，继续你的练习。</p>\n  </div>\n\n  <form class="auth-entry__form"\n        id="studentVerifyForm"\n        action="{{ url_for(\'api_listening_verify\') }}"\n        method="post"\n        novalidate>\n    <div class="auth-entry__field">\n      <label for="studentName">学生姓名</label>\n      <input type="text"\n             id="studentName"\n             name="name"\n             placeholder="请输入姓名"\n             autocomplete="name"\n             required>\n    </div>\n    <button class="auth-entry__primary" id="btnVerify" type="submit">\n      <span id="btnVerifyText">进入练习</span>\n      <i class="fas fa-arrow-right" aria-hidden="true"></i>\n    </button>\n    <div class="auth-entry__error"\n         id="errorMsg"\n         role="alert"\n         aria-live="assertive"\n         hidden></div>\n    <p class="auth-entry__help">没找到自己？请联系老师确认姓名。</p>\n  </form>\n\n  <a class="auth-entry__staff-link" href="{{ url_for(\'login\') }}?next=/practices">员工登录</a>\n  {% endcall %}\n</div>\n\n<!-- Main content (hidden until student verified) -->\n<div class="listening-page listening-library" id="mainContent" style="display:none">\n\n\n  <div class="listening-library__header">\n    <div>\n      <p class="listening-library__eyebrow">听力 / 精听</p>\n      <p class="listening-library__summary">选择一个练习开始精听训练。自由练习进度会保存在当前浏览器。</p>\n    </div>\n  </div>\n\n\n\n  <p><a href="{{ url_for(\'practice_library\') }}#practiceAssignedTasks" data-practice-nav>在练习中心查看任务与记录</a></p>\n\n  {% if exercises %}\n  {{ render_intensive_catalog(intensive_catalog, staff=False) }}\n  {% else %}\n  <div class="empty-state">\n    <h3>暂无练习</h3>\n    <p>请联系老师添加精听练习内容。</p>\n  </div>\n  {% endif %}\n</div>\n\n{% endif %}\n\n<script>\n// Only run student verification JS if not in staff mode\nif (document.getElementById(\'loginGate\')) {\n  function verifyStudent() {\n    const name = document.getElementById(\'studentName\').value.trim();\n    const error = document.getElementById(\'errorMsg\');\n    const button = document.getElementById(\'btnVerify\');\n    const buttonText = document.getElementById(\'btnVerifyText\');\n    error.hidden = true;\n    error.textContent = \'\';\n    if (!name) {\n      error.textContent = \'请输入老师登记的学生姓名。\';\n      error.hidden = false;\n      document.getElementById(\'studentName\').focus();\n      return;\n    }\n\n    buttonText.textContent = \'验证中…\';\n    button.disabled = true;\n\n    fetch(\'/api/listening/verify\', {\n      method: \'POST\',\n      headers: {\'Content-Type\': \'application/json\'},\n      body: JSON.stringify({name: name})\n    })\n    .then(r => r.json())\n    .then(data => {\n      if (data.ok) {\n        const verifiedName = data.name || name;\n        rememberStudent(verifiedName);\n        showMain(verifiedName);\n      } else {\n        error.textContent = data.error === \'student_not_found\'\n          ? \'未找到该学生，请确认姓名是否正确，或联系老师。\'\n          : (data.message || \'验证失败\');\n        error.hidden = false;\n      }\n    })\n    .catch(() => {\n      error.textContent = \'网络错误，请重试\';\n      error.hidden = false;\n    })\n    .finally(() => {\n      buttonText.textContent = \'进入练习\';\n      button.disabled = false;\n    });\n  }\n\n  function rememberStudent(name) {\n    sessionStorage.setItem(\'listening_student\', name);\n    localStorage.setItem(\'listening_student\', name);\n  }\n\n  function verifySavedStudent(name) {\n    const savedName = String(name || \'\').trim();\n    if (!savedName) return;\n    fetch(\'/api/listening/verify\', {\n      method: \'POST\',\n      headers: {\'Content-Type\': \'application/json\'},\n      body: JSON.stringify({name: savedName})\n    })\n    .then(r => r.json())\n    .then(data => {\n      if (!data.ok) {\n        logout();\n        return;\n      }\n      const verifiedName = data.name || savedName;\n      rememberStudent(verifiedName);\n      showMain(verifiedName);\n    })\n    .catch(() => {\n      showMain(savedName);\n    });\n  }\n\n  function updateIntensiveIdentity(name) {\n    const label = document.querySelector(\'[data-practice-identity-label]\');\n    if (label) label.textContent = name ? `学生：${name}` : \'未确认身份\';\n    const switchButton = document.getElementById(\'practiceIntensiveIdentitySwitch\');\n    if (switchButton) switchButton.hidden = !name;\n    const defaults = window.PRACTICE_NAVIGATION_DEFAULTS || {};\n    if ((defaults.identityMode || defaults.identity_mode) !== \'student_account\') {\n      defaults.identityMode = defaults.identity_mode = name ? \'verified_student\' : \'guest\';\n      window.PRACTICE_NAVIGATION_DEFAULTS = defaults;\n    }\n  }\n\n  function showMain(name) {\n    document.getElementById(\'loginGate\').style.display = \'none\';\n    document.getElementById(\'mainContent\').style.display = \'block\';\n    updateIntensiveIdentity(name);\n    refreshExerciseProgress(name);\n  }\n\n  function logout() {\n    sessionStorage.removeItem(\'listening_student\');\n    localStorage.removeItem(\'listening_student\');\n    document.getElementById(\'loginGate\').style.display = \'block\';\n    document.getElementById(\'mainContent\').style.display = \'none\';\n    document.getElementById(\'studentName\').value = \'\';\n    document.getElementById(\'errorMsg\').hidden = true;\n    updateIntensiveIdentity(\'\');\n    document.getElementById(\'studentName\').focus();\n  }\n\n  // Auto-login if previously verified in this session\n  document.addEventListener(\'DOMContentLoaded\', function() {\n    const saved = sessionStorage.getItem(\'listening_student\') || localStorage.getItem(\'listening_student\');\n    if (saved) verifySavedStudent(saved);\n  });\n\n  window.addEventListener(\'pageshow\', function() {\n    const saved = sessionStorage.getItem(\'listening_student\') || localStorage.getItem(\'listening_student\');\n    if (saved && document.getElementById(\'mainContent\').style.display !== \'none\') {\n      refreshExerciseProgress(saved);\n    }\n  });\n\n  document.getElementById(\'studentVerifyForm\').addEventListener(\'submit\', function(e) {\n    e.preventDefault();\n    verifyStudent();\n  });\n}\n\nfunction initListeningCatalogSearch() {\n  document.querySelectorAll(\'.js-listening-catalog\').forEach(catalog => {\n    const input = catalog.querySelector(\'.js-listening-search\');\n    if (!input || input.dataset.bound === \'1\') return;\n    input.dataset.bound = \'1\';\n    const apply = () => {\n      const query = input.value.trim().toLowerCase();\n      let visibleBooks = 0;\n\n      catalog.querySelectorAll(\'.js-listening-book-group\').forEach(book => {\n        const bookSearch = (book.dataset.search || \'\').toLowerCase();\n        const bookMatches = query && bookSearch.includes(query);\n        let visibleTests = 0;\n\n        const tests = book.querySelectorAll(\'.js-listening-test-group\');\n        if (tests.length) {\n          tests.forEach(test => {\n            const testSearch = (test.dataset.search || \'\').toLowerCase();\n            const testMatches = bookMatches || (query && testSearch.includes(query));\n            let visibleSections = 0;\n\n            test.querySelectorAll(\'.js-listening-section\').forEach(section => {\n              const sectionSearch = (section.dataset.search || \'\').toLowerCase();\n              const show = !query || testMatches || sectionSearch.includes(query);\n              section.hidden = !show;\n              if (show) visibleSections += 1;\n            });\n\n            test.hidden = visibleSections === 0;\n            if (!test.hidden) visibleTests += 1;\n          });\n          book.hidden = visibleTests === 0;\n        } else {\n          let visibleItems = 0;\n          book.querySelectorAll(\'.js-listening-section\').forEach(item => {\n            const itemSearch = (item.dataset.search || \'\').toLowerCase();\n            const show = !query || bookMatches || itemSearch.includes(query);\n            item.hidden = !show;\n            if (show) visibleItems += 1;\n          });\n          book.hidden = visibleItems === 0;\n        }\n\n        if (!book.hidden) visibleBooks += 1;\n      });\n\n      catalog.classList.toggle(\'is-empty\', visibleBooks === 0);\n    };\n    input.addEventListener(\'input\', apply);\n    apply();\n  });\n}\n\ndocument.addEventListener(\'DOMContentLoaded\', initListeningCatalogSearch);\n\nfunction refreshExerciseProgress(studentName) {\n  if (!studentName) return;\n  document.querySelectorAll(\'.js-student-exercise-card\').forEach(card => {\n    const exerciseId = card.dataset.exerciseId;\n    const segmentCount = Number(card.dataset.segmentCount || 0);\n    const labelEl = card.querySelector(\'.progress-label\');\n    const fillEl = card.querySelector(\'.progress-fill\');\n    if (!exerciseId || !labelEl || !fillEl) return;\n\n    let progress = {};\n    try {\n      progress = JSON.parse(localStorage.getItem(`listening_free_progress_${exerciseId}_${studentName}`) || \'{}\') || {};\n    } catch (err) {\n      progress = {};\n    }\n\n    const rows = Object.values(progress);\n    const completedCount = rows.filter(item => item && item.is_completed).length;\n    const totalWords = rows.reduce((sum, item) => sum + (Number(item.total_words) || 0), 0);\n    const correctWords = rows.reduce((sum, item) => sum + (Number(item.correct_words) || 0), 0);\n    const accuracy = totalWords > 0 ? Math.round(correctWords * 100 / totalWords) : 0;\n    const pct = segmentCount > 0 ? Math.round(completedCount * 100 / segmentCount) : 0;\n\n    if (completedCount > 0) {\n      labelEl.textContent = `${completedCount}/${segmentCount} 句 · 正确率 ${accuracy}%`;\n      labelEl.classList.remove(\'muted\');\n      fillEl.style.width = pct + \'%\';\n    } else {\n      labelEl.textContent = \'尚未开始\';\n      labelEl.classList.add(\'muted\');\n      fillEl.style.width = \'0%\';\n    }\n  });\n}\n\n// 学生卡片：除了 CTA，整卡也可点（保持原行为）\ndocument.querySelectorAll(\'.js-student-exercise-card\').forEach(card => {\n  card.addEventListener(\'click\', function(e) {\n    if (e.target.closest(\'a, button\')) return;\n    const href = card.dataset.href;\n    if (href) window.location.href = href;\n  });\n});\n\ndocument.querySelectorAll(\'.js-delete-exercise\').forEach(btn => {\n  btn.addEventListener(\'click\', async function(e) {\n    e.preventDefault();\n    const exerciseId = this.dataset.id;\n    if (!exerciseId) return;\n    if (this.disabled) {\n      alert(\'该练习已经被任务引用，不能删除。\');\n      return;\n    }\n    if (!confirm(`确认删除精听练习 ${exerciseId}？删除后音频和文本将一起移除。`)) return;\n    this.disabled = true;\n    try {\n      const res = await fetch(`/api/listening/${encodeURIComponent(exerciseId)}/delete`, { method: \'POST\' });\n      const data = await res.json();\n      if (!data.ok) {\n        alert(data.message || data.error || \'删除失败\');\n        this.disabled = false;\n        return;\n      }\n      location.reload();\n    } catch (err) {\n      this.disabled = false;\n      alert(\'删除失败，请稍后重试\');\n    }\n  });\n});\n</script>\n{% include "practice/_navigation_defaults.html" %}\n<script src="{{ url_for(\'static\', filename=\'js/practice_shell.js\') }}"></script>\n<script>PracticeShell.installListContext({ ...window.PRACTICE_NAVIGATION_DEFAULTS, sourceMode: \'intensive_library\' }); PracticeShell.installHub(window.PRACTICE_NAVIGATION_DEFAULTS);</script>\n</body>\n</html>\n' : templates/listening/index.html
