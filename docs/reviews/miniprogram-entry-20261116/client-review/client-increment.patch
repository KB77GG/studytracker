+test('learning queue shows a 10 second hint and accepts the observed 13 second success without retry', async () => {
+    const h = harness('learning'), pending = h.page.fetchQueue(); await flush()
+    assert.equal(h.requests[0].timeout, 30000)
+    await h.tick(10000); assert.equal(h.page.data.loadSlow, true); assert.equal(h.page.data.loadError, '')
+    await h.tick(3000); await h.reply(0, queue()); await pending
+    assert.equal(h.page.data.queueToken, 'synthetic-queue'); assert.equal(h.page.data.loading, false)
+    assert.equal(h.requests.length, 1); assert.equal(h.timers.size, 0)
+})
+
+test('learning queue 30 second timeout permits explicit retry and ignores the late old reply', async () => {
+    const h = harness('learning'), old = h.page.fetchQueue(); await flush()
+    await h.tick(30000); await old; assert.match(h.page.data.loadError, /超时/)
+    const retry = h.page.retry(); await flush(); await h.reply(1, task()); await h.reply(2, queue('new')); await retry
+    await h.reply(0, queue('old'))
+    assert.equal(h.page.data.queueToken, 'new'); assert.equal(h.page.data.loadError, '')
+    assert.equal(h.requests.length, 3); assert.ok(h.requests.every(x => x.method === 'GET'))
+})
+
+test('learning unload cancels slow/deadline timers and ignores a late response', async () => {
