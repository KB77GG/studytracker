@@ -0,0 +1,47 @@
+// Bounded page-entry loading. The caller owns network requests and ignores late replies.
+function createLoadGuard(options = {}) {
+    let stopped = false
+    let rejectDeadline
+    const deadline = new Promise((resolve, reject) => { rejectDeadline = reject })
+    // A guard can be cancelled between requests without an unhandled rejection.
+    deadline.catch(() => {})
+    const slowTimer = setTimeout(() => {
+        if (!stopped && options.onSlow) options.onSlow()
+    }, options.slowMs || 10000)
+    const timeoutTimer = setTimeout(() => {
+        if (!stopped) rejectDeadline({ deadline: true, errMsg: 'request:fail timeout' })
+    }, options.timeoutMs || 30000)
+    function finish() {
+        stopped = true
+        clearTimeout(slowTimer)
+        clearTimeout(timeoutTimer)
+    }
+    return {
+        wait(factory) {
+            return Promise.race([Promise.resolve().then(() => {
+                if (stopped) throw { pageUnloaded: true, errMsg: 'request:fail abort' }
+                return factory()
+            }), deadline])
+        },
+        finish,
+        cancel() {
+            finish()
+            rejectDeadline({ pageUnloaded: true, errMsg: 'request:fail abort' })
+        }
+    }
+}
+
+function pageLoadError(error, subject = '任务') {
+    const detail = error || {}
+    const message = String(detail.errMsg || detail.message || detail.error || '')
+    const status = Number(detail.statusCode || 0)
+    if (detail.deadline || /timeout/i.test(message)) return '加载超时，请检查网络后重试'
+    if (status === 401 || detail.error === 'unauthorized') return '登录已失效，请重新登录'
+    if (status === 403) return '暂时无法访问此任务，请返回任务列表'
+    if (status === 404) return '任务不存在或已移除，请返回任务列表'
+    if (status >= 500) return '服务暂时繁忙，请稍后重试'
+    if (/request:fail|network|network_error/i.test(message)) return '网络连接失败，请检查网络后重试'
+    return `${subject}加载失败，请重试`
+}
+
+module.exports = { createLoadGuard, pageLoadError }
