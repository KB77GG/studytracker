+    assert.match(h.page.data.taskLoadError, /服务暂时繁忙/); await assertMutationBlocked(h)
+    const retry = h.page.retryTaskLoad(); await flush()
+    await h.reply(2, vocabTask()); await h.reply(3, { ok: true, required: true }); await retry
+    assert.match(h.redirects[0].url, /vocabulary-review/)
