+    assert.equal(JSON.stringify(h.page.data), before)
+    assert.equal(h.requests.length, 1); assert.equal(h.timers.size, 0); await assertMutationBlocked(h)
+})
+
+test('task server failure and failed navigation show retry instead of an editable empty form', async () => {
