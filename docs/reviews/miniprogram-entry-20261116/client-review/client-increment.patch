+    const timers = new Map(), requests = [], redirects = [], calls = { record: 0, image: 0, spinner: 0 }
+    const app = { globalData: { baseUrl: 'https://synthetic.test/api', token: 'synthetic-token' } }
+    const audio = { onPlay() {}, onPause() {}, onStop() {}, onEnded() {}, onError() {}, onCanplay() {}, destroy() {}, stop() {}, play() {} }
+    const wx = {
+        request: options => { requests.push(options); return { abort() {} } },
+        getStorageSync() { return '' }, removeStorageSync() {}, setStorageSync() {},
+        getRecorderManager: () => ({ onStop() {}, start() { calls.record++ }, stop() {} }),
+        createInnerAudioContext: () => audio,
+        showToast() {}, showLoading() { calls.spinner++ }, hideLoading() { calls.spinner-- },
+        showModal: async () => ({ confirm: true }),
+        redirectTo: options => redirects.push(options), reLaunch() {}, switchTab() {}, navigateBack() {},
+        chooseImage() { calls.image++ }, setInnerAudioOption() {}
+    }
+    const sandbox = {
+        console: { warn() {}, error() {}, log() {}, info() {} }, Promise, Set, Map, Date,
+        getApp: () => app, wx, Page: value => { definition = value },
+        setTimeout: (fn, ms) => { const id = ++timerId; timers.set(id, { at: now + ms, fn }); return id },
+        clearTimeout: id => timers.delete(id), setInterval: () => 99, clearInterval() {}
+    }
+    const modules = new Map()
+    function load(file) {
+        const absolute = path.resolve(file)
+        if (modules.has(absolute)) return modules.get(absolute).exports
+        const module = { exports: {} }; modules.set(absolute, module)
+        const local = Object.assign({}, sandbox, { module, exports: module.exports, require: name => load(path.resolve(path.dirname(absolute), name)) })
+        vm.runInNewContext(fs.readFileSync(absolute, 'utf8'), local, { filename: absolute })
+        return module.exports
+    }
+    load(path.join(ROOT, 'miniprogram/pages/student', kind === 'task' ? 'task/index.js' : 'vocabulary-learning/index.js'))
+    const page = { ...definition, data: JSON.parse(JSON.stringify(definition.data)) }
+    page.setData = function (data, callback) { Object.assign(this.data, data); if (callback) callback() }
+    page.data.taskId = kind === 'task' ? 42 : '42'
+    page._taskPageActive = true; page._learningPageActive = true; page._learningDeadlineTimers = new Set()
+    page.audioPlayer = { play() {}, preload: () => Promise.resolve([]), destroy() {} }
+    return {
+        page, requests, redirects, calls, timers,
+        async tick(ms) {
+            const target = now + ms
+            for (;;) {
+                const due = Array.from(timers).filter(([, timer]) => timer.at <= target).sort((a, b) => a[1].at - b[1].at)[0]
+                if (!due) break
+                now = due[1].at; timers.delete(due[0]); due[1].fn(); await flush()
+            }
+            now = target; await flush()
+        },
+        async reply(index, data, statusCode = 200) { requests[index].success({ statusCode, data }); await flush() },
+        async fail(index, errMsg = 'request:fail network') { requests[index].fail({ errMsg }); await flush() }
+    }
+}
+const task = extra => ({ ok: true, task: { id: 42, task_name: '合成任务', status: 'pending', ...extra } })
+const vocabTask = () => task({ dictation_book_id: 1, vocabulary_goal: 'reading' })
+const queue = (token = 'synthetic-queue') => ({ ok: true, task_id: 42, queue_token: token, phase: 'familiarity', familiarity: [], current_question: null })
+
+async function assertMutationBlocked(h) {
+    const count = h.requests.length
+    h.page.chooseImage(); h.page.startRecord(); await h.page.submitTask()
+    assert.equal(h.requests.length, count, 'blocked entry must not post')
+    assert.equal(h.calls.image, 0); assert.equal(h.calls.record, 0)
+}
+
+test('task entry retains fetched details during preflight, stays blocked, and accepts a 13 second response', async () => {
+    const h = harness('task'), pending = h.page.fetchTaskDetail(); await flush()
+    await assertMutationBlocked(h)
+    await h.reply(0, vocabTask())
+    assert.equal(h.page.data.task.task_name, '合成任务')
+    assert.equal(h.requests.length, 2)
+    await h.tick(10000); assert.equal(h.page.data.taskLoadSlow, true)
+    await h.page.retryTaskLoad(); assert.equal(h.requests.length, 2, 'retry while loading must not duplicate requests')
+    await assertMutationBlocked(h)
+    await h.tick(3000); await h.reply(1, { ok: true, required: false }); await pending
+    assert.equal(h.redirects[0].url, '/pages/student/vocabulary-learning/index?taskId=42')
+    assert.equal(h.page.data.taskLoadError, '')
+    await assertMutationBlocked(h)
+    assert.equal(h.calls.spinner, 0)
+})
+
+test('task total 30 second deadline, retry, and late success cannot restore the old task', async () => {
+    const h = harness('task'), old = h.page.fetchTaskDetail(); await flush()
+    await h.tick(30000); await old
+    assert.match(h.page.data.taskLoadError, /超时/); await assertMutationBlocked(h)
+    const retry = h.page.retryTaskLoad(); await flush()
+    await h.reply(1, task({ task_name: '新响应' })); await retry
+    assert.equal(h.page.data.taskLoaded, true)
+    await h.reply(0, vocabTask())
+    assert.equal(h.page.data.task.task_name, '新响应'); assert.equal(h.requests.length, 2)
+    assert.equal(h.timers.size, 0)
+})
+
+test('task details and preflight share one deadline and failure preserves visible task details', async () => {
+    const h = harness('task'), pending = h.page.fetchTaskDetail(); await flush()
+    await h.tick(20000); await h.reply(0, vocabTask()); await h.tick(10000); await pending
+    assert.match(h.page.data.taskLoadError, /超时/)
+    assert.equal(h.page.data.task.task_name, '合成任务'); await assertMutationBlocked(h)
+    await h.reply(1, { ok: true, required: false }); assert.equal(h.redirects.length, 0)
+})
+
+test('task unload cancels deadline and blocks late success and all mutations', async () => {
