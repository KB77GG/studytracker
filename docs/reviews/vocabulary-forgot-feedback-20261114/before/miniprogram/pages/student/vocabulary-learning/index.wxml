<view class="learning-page-shell">
<view class="learning-page">
  <view class="loading" wx:if="{{loading}}">
    <view class="loading-shell">
      <view class="skeleton skeleton-title"></view>
      <view class="skeleton skeleton-line"></view>
      <view class="skeleton skeleton-card"></view>
      <text class="loading-label">加载小组学习…</text>
    </view>
    <button class="secondary-btn loading-exit" bindtap="exitPage">返回</button>
  </view>

  <view class="error-panel" wx:elif="{{loadError}}">
    <text>{{loadError}}</text>
    <button class="secondary-btn" bindtap="retry">重试</button>
  </view>

  <view class="summary-panel" wx:elif="{{finished}}">
    <text class="summary-title">词汇任务完成</text>
    <text class="summary-score">{{result.correct_count}} / {{result.total_count}}</text>
    <text class="summary-copy">首答正确率 {{result.accuracy}}%。重试只用于巩固，不改首答成绩。</text>
    <text class="summary-copy" wx:if="{{result.skipped_count}}">安全资料不足，已跳过 {{result.skipped_count}} 个不可判分维度。</text>
    <text class="summary-copy" wx:if="{{forgotCount > 0}}">本轮忘记 {{forgotCount}} 题，已转入后续复习。</text>
    <view wx:if="{{forgotItems.length > 0}}" class="forgot-summary">
      <text class="forgot-summary-title">本轮忘记的词</text>
      <view wx:for="{{forgotItems}}" wx:key="key" class="forgot-summary-item">
        <view class="forgot-summary-copy">
          <text class="forgot-summary-word">{{item.word}}</text>
          <text class="forgot-summary-meaning">{{item.meaning}}</text>
          <text class="forgot-summary-answer">本题正确答案：{{item.answer}}</text>
        </view>
        <button class="secondary-btn forgot-replay" bindtap="playForgotAudio" data-index="{{index}}" disabled="{{!item.audioSources.length}}">重听</button>
      </view>
    </view>
    <button class="primary-btn" bindtap="exitPage">返回任务</button>
  </view>

  <view class="date-gate-card" wx:elif="{{readOnly}}">
    <text class="date-gate-title">{{dateStatusText}}</text>
    <text class="date-gate-copy">任务按所属日期开放，当前仅可查看，不能开始学习、答题或提交。</text>
  </view>

  <block wx:else>
    <view class="topbar">
      <view>
        <text class="eyebrow">词汇小组学习</text>
        <text class="group-title">第 {{groupNumber}} / {{groupCount}} 组</text>
      </view>
      <text class="word-total">共 {{totalWordCount}} 词</text>
    </view>

    <view class="progress-strip">
      <text wx:if="{{groupPositionTotal}}">组内位置 {{groupPosition}} / {{groupPositionTotal}}</text>
      <text>本组基础 {{baseProgressCompleted}} / {{baseProgressTotal}}</text>
      <text wx:if="{{remediationAllocatedTotal > 0 || remediationPendingCount > 0 || deferredReviewCount > 0}}">
        错题补强 已完成 {{remediationProgressCompleted}} / 已分配 {{remediationAllocatedTotal}}（上限 {{remediationBudgetTotal}}）
      </text>
      <text wx:if="{{deferredReviewCount > 0}}">已转今日复习 {{deferredReviewCount}}</text>
    </view>
    <view class="progress-track learning-progress-track" wx:if="{{groupPositionTotal}}">
      <view class="progress-fill" style="width: {{(groupPosition / groupPositionTotal) * 100}}%;"></view>
    </view>
    <view class="phase-strip">
      <text>当前阶段：{{phaseLabel}}</text>
      <text wx:if="{{diagnostics.length}}">资料降级 {{diagnostics.length}} 项</text>
    </view>

    <block wx:if="{{phase === 'familiarity'}}">
      <view class="card familiarity-card" wx:if="{{familiarity.length}}">
        <view class="familiarity-progress">
          <text>组内熟悉 {{familiarityIndex + 1}} / {{familiarity.length}}</text>
          <text wx:if="{{familiarity[familiarityIndex].viewed}}">已浏览</text>
        </view>
        <block wx:if="{{familiarity[familiarityIndex]}}">
          <text class="familiar-word">{{familiarity[familiarityIndex].word}}</text>
          <text class="phonetic">{{familiarity[familiarityIndex].phonetic}}</text>
          <text class="meaning">{{familiarity[familiarityIndex].meaning}}</text>
          <view class="audio-area state-{{audioState}}">
            <button class="audio-btn state-{{audioState}}" bindtap="playAudio" loading="{{audioState === 'loading'}}">
              <image class="play-icon" src="/images/icons/vocabulary-speaker-wave-white.svg" mode="aspectFit" />
            </button>
            <text class="audio-label">{{audioButtonLabel}}</text>
          </view>
          <text class="material-label" wx:if="{{familiarity[familiarityIndex].usage_pattern}}">必要搭配</text>
          <text class="material-text" wx:if="{{familiarity[familiarityIndex].usage_pattern}}">{{familiarity[familiarityIndex].usage_pattern}}</text>
          <text class="material-label" wx:if="{{familiarity[familiarityIndex].example_en}}">例句</text>
          <text class="material-text" wx:if="{{familiarity[familiarityIndex].example_en}}">{{familiarity[familiarityIndex].example_en}}</text>
          <text class="material-text translation" wx:if="{{familiarity[familiarityIndex].example_zh}}">{{familiarity[familiarityIndex].example_zh}}</text>
        </block>
      </view>
      <view class="navigation-row">
        <button class="secondary-btn" bindtap="previousFamiliarity" disabled="{{familiarityIndex === 0}}">上一词</button>
        <button class="primary-btn" bindtap="nextFamiliarity" disabled="{{familiarityConfirming || familiarityEntering}}">
          {{isLastFamiliarity ? '完成熟悉，进入检测' : (familiarity[familiarityIndex].viewed ? '下一词' : '看过并继续')}}
        </button>
      </view>
      <text class="hint">熟悉材料只记录浏览，不增加掌握度；整组浏览完成后才开始测试。</text>
    </block>

    <block wx:elif="{{currentQuestion}}">
      <view class="card question-card">
        <text class="question-kind">{{phaseLabel}}</text>
        <block wx:if="{{currentQuestion.mode === 'en_to_zh'}}">
          <text class="prompt-word">{{currentQuestion.question.prompt.word}}</text>
          <text class="mode-copy">看英文 · 写中文释义</text>
        </block>
        <block wx:elif="{{currentQuestion.mode === 'zh_to_en'}}">
          <text class="prompt-meaning">{{currentQuestion.question.prompt.meaning}}</text>
          <text class="mode-copy">看中文 · 写英文表达</text>
        </block>
        <block wx:elif="{{currentQuestion.mode === 'audio_to_en' || currentQuestion.mode === 'audio_to_zh'}}">
          <view class="audio-area state-{{audioState}}">
            <button class="audio-btn state-{{audioState}}" bindtap="playAudio" loading="{{audioState === 'loading'}}">
              <image class="play-icon" src="/images/icons/vocabulary-speaker-wave-white.svg" mode="aspectFit" />
            </button>
            <text class="audio-label">{{audioButtonLabel}}</text>
          </view>
          <text class="mode-copy">{{currentQuestion.question.answer_type === 'numeric' ? (currentQuestion.question.prompt.instruction || '听音 · 输入数字、日期或号码') : (currentQuestion.mode === 'audio_to_en' ? '听音 · 拼写英文表达' : '听音 · 选择中文释义')}}</text>
          <text class="hint" wx:if="{{currentQuestion.question.answer_type === 'numeric' && currentQuestion.question.prompt.input_hint}}">{{currentQuestion.question.prompt.input_hint}}</text>
          <view class="options" wx:if="{{isMeaningChoice && !showResult}}">
            <view wx:for="{{meaningOptions}}" wx:key="id"
                  class="option {{selectedOption === item.id ? 'selected' : ''}}"
                  bindtap="selectOption" data-id="{{item.id}}"
                  data-learning-question-id="{{currentQuestion.learning_question_id}}"
                  data-question-id="{{currentQuestion.question_id}}" data-render-epoch="{{answerRenderEpoch}}">{{item.label}}</view>
          </view>
        </block>
        <block wx:elif="{{currentQuestion.mode === 'context_choice'}}">
          <text class="prompt-copy">{{currentQuestion.question.prompt.instruction}}</text>
          <text class="target-word" wx:if="{{currentQuestion.question.prompt.target_word}}">目标词：{{currentQuestion.question.prompt.target_word}}</text>
          <text class="sentence" wx:if="{{currentQuestion.question.prompt.sentence}}">{{currentQuestion.question.prompt.sentence}}</text>
          <view class="options" wx:if="{{!showResult}}">
            <view wx:for="{{currentQuestion.question.options}}" wx:key="id"
                  class="option {{selectedOption === item.id ? 'selected' : ''}}"
                  bindtap="selectOption" data-id="{{item.id}}"
                  data-learning-question-id="{{currentQuestion.learning_question_id}}"
                  data-question-id="{{currentQuestion.question_id}}" data-render-epoch="{{answerRenderEpoch}}">{{item.label}}</view>
          </view>
        </block>
        <block wx:elif="{{currentQuestion.mode === 'context_fill'}}">
          <text class="prompt-copy">{{currentQuestion.question.prompt.instruction}}</text>
          <text class="sentence">{{currentQuestion.question.prompt.sentence}}</text>
          <view class="translation-block" wx:if="{{currentQuestion.question.prompt.translation}}">
            <text class="translation-label">{{currentQuestion.question.prompt.translation_label || '中文提示'}}</text>
            <text class="translation">{{currentQuestion.question.prompt.translation}}</text>
          </view>
        </block>

        <input wx:if="{{!showResult && !isMeaningChoice && currentQuestion.mode !== 'context_choice'}}"
               class="answer-input" value="{{inputValue}}" bindinput="onInput"
               bindconfirm="submitAnswer" data-learning-question-id="{{currentQuestion.learning_question_id}}"
               data-question-id="{{currentQuestion.question_id}}" data-render-epoch="{{answerRenderEpoch}}"
               confirm-type="done" placeholder="{{currentQuestion.question.answer_type === 'numeric' ? '输入听到的答案，保留必要符号' : '输入答案'}}"
               placeholder-style="color: #9AA3AE;" />
        <view wx:if="{{showResult}}" class="result {{isCorrect ? 'correct' : 'wrong'}}">
          <view class="result-heading">
            <image wx:if="{{isCorrect}}" class="result-icon" src="/images/icons/vocabulary-check-outline.svg" mode="aspectFit" />
            <image wx:else class="result-icon" src="/images/icons/vocabulary-xmark-outline.svg" mode="aspectFit" />
            <text>{{responseKind === 'forgot' ? '已记为未掌握' : (isCorrect ? '答对了' : (phase === 'retry' ? '仍需巩固' : '首答需要加强'))}}</text>
          </view>
          <text class="result-line">你的答案：{{submittedAnswer}}</text>
          <text class="result-line">正确答案：{{correctAnswer}}</text>
        </view>
        <view wx:if="{{showResult && correctionRequired}}" class="correction-panel">
          <text class="correction-title">立即纠正（不计正式题）</text>
          <text class="correction-copy">第 {{(correctionCount || 0) + 1}} / {{correctionMaxAttempts || 2}} 次</text>
          <text class="correction-copy">{{correctionPrompt}}；纠正不计正式题，之后系统会延迟重测原维度。</text>
          <text class="correction-wrong" wx:if="{{correctionCount > 0 && correctionIsCorrect === false}}">这次纠正仍不正确，请再试一次；达到上限后会安全转入后续复习。</text>
          <text class="correction-prompt">{{correctionPrompt}}</text>
          <input class="correction-input" value="{{correctionInputValue}}"
                 bindinput="onCorrectionInput" bindconfirm="submitCorrection"
                 confirm-type="done" placeholder="{{correctionPrompt}}"
                 placeholder-style="color: #9AA3AE;" />
          <button class="primary-btn correction-btn {{correctionSubmitting ? 'is-loading' : ''}}" bindtap="submitCorrection"
                  disabled="{{correctionSubmitting || !correctionHasInput}}">
            {{correctionSubmitting ? '保存纠正…' : '提交纠正'}}
          </button>
        </view>
        <view wx:if="{{showResult && correctionCompleted}}" class="correction-done">
          {{correctionExhausted ? '纠正次数已达上限，已标记为待后续复习。' : '正确纠正已记录，不计入正式题；后续会按间隔再次检查。'}}
        </view>
        <button
          wx:if="{{showResult && !isCorrect && currentQuestion.mode !== 'context_choice'}}"
          class="answer-appeal-btn"
          bindtap="submitAnswerAppeal"
          disabled="{{appealSubmitting || appealSubmitted}}"
        >
          {{appealSubmitting ? '提交中…' : (appealSubmitted ? '已提交人工审核' : '判分有疑问？申诉')}}
        </button>
        <vocabulary-feedback-card
          wx:if="{{showResult && answerFeedback}}"
          feedback="{{answerFeedback}}"
          audio-state="{{audioState}}"
          bind:replay="playAudio"
        />
      </view>

      <view wx:if="{{!showResult}}" class="forgot-actions">
        <button wx:if="{{supportsForgotResponse}}" class="secondary-btn forgot-btn" bindtap="submitForgot"
                data-learning-question-id="{{currentQuestion.learning_question_id}}" data-question-id="{{currentQuestion.question_id}}"
                data-render-epoch="{{answerRenderEpoch}}" disabled="{{submitting || finishing || correctionSubmitting}}">忘了</button>
        <button class="primary-btn forgot-submit-btn {{submitting ? 'is-loading' : ''}}" bindtap="submitAnswer"
                data-learning-question-id="{{currentQuestion.learning_question_id}}" data-question-id="{{currentQuestion.question_id}}"
                data-render-epoch="{{answerRenderEpoch}}" disabled="{{submitting || finishing || correctionSubmitting}}">
          {{submitting ? '保存中…' : '提交答案'}}
        </button>
      </view>
      <text wx:if="{{!showResult && supportsForgotResponse}}" class="forgot-note">忘了会记为未掌握，并安排后续复习</text>
      <button wx:if="{{showResult}}" class="primary-btn next-question-btn" bindtap="submitAnswer"
              data-learning-question-id="{{currentQuestion.learning_question_id}}" data-question-id="{{currentQuestion.question_id}}"
              data-render-epoch="{{answerRenderEpoch}}" disabled="{{submitting || finishing || appealSubmitting || correctionRequired}}">
        {{correctionRequired ? '先完成纠正' : '下一题'}}
      </button>
      <text class="hint" wx:if="{{phase === 'retry'}}">错题至少完成一次纠正性重试；再次答错也不会无限循环。</text>
    </block>
  </block>

  <view wx:if="{{familiarityConfirming}}" class="confirm-layer" catchtap="cancelFamiliarityCompletion">
    <view class="confirm-card" catchtap="noop">
      <view class="confirm-title-row">
        <image class="confirm-icon" src="/images/icons/vocabulary-flag-outline.svg" mode="aspectFit" />
        <text class="confirm-title">开始本组检测？</text>
      </view>
      <text class="confirm-copy">你已浏览完本组全部单词。进入检测后将开始正式作答，并记录本组学习结果。</text>
      <view class="confirm-actions">
        <button class="secondary-btn" bindtap="cancelFamiliarityCompletion" disabled="{{familiarityEntering}}">继续查看</button>
        <button class="primary-btn {{familiarityEntering ? 'is-loading' : ''}}" bindtap="startFamiliarityDetection" disabled="{{familiarityEntering}}">{{familiarityEntering ? '进入检测…' : '开始检测'}}</button>
      </view>
    </view>
  </view>
</view>
</view>
