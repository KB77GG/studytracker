diff --git a/tests/test_vocabulary_due_cache.py b/tests/test_vocabulary_due_cache.py
index a4d5ac23..9bffe85c 100644
--- a/tests/test_vocabulary_due_cache.py
+++ b/tests/test_vocabulary_due_cache.py
@@ -8,8 +8,9 @@ from unittest.mock import Mock, patch
 from flask import Flask
 from sqlalchemy import update
 
-from models import DictationBook, DictationWord, User, db
+from models import DictationBook, DictationWord, StudentVocabularyMastery, User, db
 from services.vocabulary_due_cache import (
+    BULK_USERS_OPTION,
     _cache,
     _DueCache,
     cached_due_sense_ids,
@@ -202,6 +203,55 @@ class VocabularyDueCacheTest(unittest.TestCase):
         cache.read(("db", 1, "day"), self.now, loader, lambda: True)
         self.assertFalse(cache.entries)
 
+    def test_other_students_write_during_load_does_not_block_publication(self):
+        cache = _DueCache()
+
+        def loader():
+            cache.invalidate({2})  # a different student answers while this count loads
+            return [1]
+
+        cache.read(("db", 1, "day"), self.now, loader, lambda: True)
+        self.assertIn(("db", 1, "day"), cache.entries)
+
+    def test_catalog_write_during_load_still_prevents_publication(self):
+        cache = _DueCache()
+
+        def loader():
+            cache.invalidate()  # shared catalog edit: every student's count may change
+            return [1]
+
+        cache.read(("db", 1, "day"), self.now, loader, lambda: True)
+        self.assertFalse(cache.entries)
+
+    def test_scoped_bulk_update_only_invalidates_the_named_student(self):
+        loader = Mock(return_value=[1])
+        other_loader = Mock(return_value=[2])
+        self.load(loader)
+        self.load(other_loader, self.other)
+        statement = (
+            update(StudentVocabularyMastery)
+            .where(StudentVocabularyMastery.student_id == self.user.id)
+            .values(meaning_recall_stage=2)
+        )
+        db.session.execute(statement, execution_options={BULK_USERS_OPTION: (self.user.id,)})
+        db.session.commit()
+        self.load(loader)
+        self.load(other_loader, self.other)
+        self.assertEqual(loader.call_count, 2)
+        self.assertEqual(other_loader.call_count, 1)
+
+    def test_unscoped_bulk_update_of_student_rows_invalidates_everyone(self):
+        loader = Mock(return_value=[1])
+        other_loader = Mock(return_value=[2])
+        self.load(loader)
+        self.load(other_loader, self.other)
+        db.session.execute(update(StudentVocabularyMastery).values(meaning_recall_stage=3))
+        db.session.commit()
+        self.load(loader)
+        self.load(other_loader, self.other)
+        self.assertEqual(loader.call_count, 2)
+        self.assertEqual(other_loader.call_count, 2)
+
 
 if __name__ == "__main__":
     unittest.main()
diff --git a/tests/test_vocabulary_flow_backlog_gate.py b/tests/test_vocabulary_flow_backlog_gate.py
index 39b97597..16877735 100644
--- a/tests/test_vocabulary_flow_backlog_gate.py
+++ b/tests/test_vocabulary_flow_backlog_gate.py
@@ -362,6 +362,47 @@ class VocabularyFlowBacklogGateTest(unittest.TestCase):
         self.assertEqual(preflight["due_count"], summary["due_count"])
         self.assertGreater(summary["due_count"], 0)
 
+    def test_one_students_review_answer_keeps_other_students_counts_cached(self):
+        reader = self._student("f", BACKLOG)
+        writer = self._student("g", BACKLOG)
+        summary_url = "/api/miniprogram/student/vocabulary-review/summary"
+        loads = []
+        original = review._eligible_due_sense_ids
+
+        def counted(user, now):
+            loads.append(user.id)
+            return original(user, now)
+
+        with patch.object(review, "_eligible_due_sense_ids", side_effect=counted):
+            self.assertEqual(self._get(reader, summary_url).get_json()["due_count"], BACKLOG)
+            session = self._claim(writer)
+            before = self._get(writer, summary_url).get_json()
+            item = session["items"][0]
+            answered = self._post(
+                writer,
+                f"/api/miniprogram/student/vocabulary-review/sessions/{session['session_id']}/answers",
+                {
+                    "session_token": session["session_token"],
+                    "review_item_id": item["review_item_id"],
+                    "question_id": item["question_id"],
+                    "word_id": item["word_id"],
+                    "sense_id": item["sense_id"],
+                    "dimension": item["dimension"],
+                    "answer": self._stored_answer(VocabularyReviewItem, item["review_item_id"]),
+                    "attempt_id": "cache-isolation-1",
+                    "input_mode": "native",
+                },
+            )
+            self.assertEqual(answered.status_code, 200, answered.get_json())
+            reader_loads_before = loads.count(reader["id"])
+            self.assertEqual(self._get(reader, summary_url).get_json()["due_count"], BACKLOG)
+            after = self._get(writer, summary_url).get_json()
+
+        # The other student's snapshot survived the answer ...
+        self.assertEqual(loads.count(reader["id"]), reader_loads_before)
+        # ... while the answering student's own numbers were recomputed.
+        self.assertEqual(after["due_count"], before["due_count"] - 1)
+
 
 if __name__ == "__main__":
     unittest.main()
