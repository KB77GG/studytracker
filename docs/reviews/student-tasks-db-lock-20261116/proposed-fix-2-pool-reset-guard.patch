+@event.listens_for(Pool, "reset")
+def _rollback_transaction_left_open(dbapi_connection, _record, _reset_state) -> None:
+    """Never return a connection to the pool while it is still mid-transaction.
+
+    When SQLite answers COMMIT with "database is locked" the transaction stays
+    open and keeps its lock.  SQLAlchemy treats the failed commit as finished
+    and skips the usual rollback on check-in, so the idle pooled connection
+    would block every other request until it happens to be reused.
+    """
+
+    if getattr(dbapi_connection, "in_transaction", False):
+        dbapi_connection.rollback()
+
