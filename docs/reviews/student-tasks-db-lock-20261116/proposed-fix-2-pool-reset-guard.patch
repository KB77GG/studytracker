index 0000000..13eea70
--- /dev/null
+++ b/tests/test_sqlite_pool_reset.py
@@ -0,0 +1,81 @@
+"""A failed COMMIT must not leave an idle pooled connection holding SQLite locks."""
+
+import sqlite3
+import tempfile
+import unittest
+from pathlib import Path
+
+from flask import Flask
+from sqlalchemy import text
+from sqlalchemy.exc import OperationalError
+
+from models import db
+
+
+class SqlitePoolResetTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.db_path = Path(self.tmp.name) / "synthetic.db"
+        raw = sqlite3.connect(self.db_path)
+        raw.execute("CREATE TABLE synthetic (id INTEGER PRIMARY KEY, v TEXT)")
+        raw.executemany("INSERT INTO synthetic (v) VALUES (?)", [("original",)] * 50)
+        raw.commit()
+        raw.close()
+        self.app = Flask(__name__)
+        self.app.config.update(
+            SQLALCHEMY_DATABASE_URI=f"sqlite:///{self.db_path}",
+            SQLALCHEMY_ENGINE_OPTIONS={"connect_args": {"timeout": 0.2}},
+            SQLALCHEMY_TRACK_MODIFICATIONS=False,
+        )
+        db.init_app(self.app)
+
+    def tearDown(self):
+        with self.app.app_context():
+            db.session.remove()
+            db.engine.dispose()
+        self.tmp.cleanup()
+
+    def _other_connection_can(self, sql):
+        raw = sqlite3.connect(self.db_path, timeout=0.2, isolation_level=None)
+        try:
+            raw.execute(sql)
+            if raw.in_transaction:
+                raw.execute("ROLLBACK")
+            return True
+        except sqlite3.OperationalError:
+            return False
+        finally:
+            raw.close()
+
+    def test_failed_commit_without_explicit_rollback_releases_its_lock(self):
+        # A reader that is still fetching keeps COMMIT waiting past the busy timeout.
+        reader = sqlite3.connect(self.db_path, timeout=0.2)
+        cursor = reader.execute("SELECT * FROM synthetic")
+        cursor.fetchone()
+
+        # A request handler that commits and lets the error propagate; the app
+        # context teardown (scoped_session.remove()) is the only clean-up.
+        with self.app.app_context():
+            db.session.execute(text("UPDATE synthetic SET v='failed request' WHERE id=1"))
+            with self.assertRaises(OperationalError):
+                db.session.commit()
+        cursor.close()
+        reader.close()
+
+        self.assertTrue(self._other_connection_can("SELECT count(*) FROM synthetic"))
+        self.assertTrue(self._other_connection_can("BEGIN IMMEDIATE"))
+        with self.app.app_context():
+            value = db.session.execute(text("SELECT v FROM synthetic WHERE id=1")).scalar()
+        self.assertEqual(value, "original")
+
+    def test_successful_commit_is_untouched(self):
+        with self.app.app_context():
+            db.session.execute(text("UPDATE synthetic SET v='saved' WHERE id=2"))
+            db.session.commit()
+        with self.app.app_context():
+            value = db.session.execute(text("SELECT v FROM synthetic WHERE id=2")).scalar()
+        self.assertEqual(value, "saved")
+
+
+if __name__ == "__main__":
+    unittest.main()
