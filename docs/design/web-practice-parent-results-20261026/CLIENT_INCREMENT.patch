+    assert.equal(page.data.detail.writingResult.wordCountText, '2 / 200')
+    assert.equal(page.data.detail.writingResult.speedText, '1.5 词/分钟')
+    assert.equal(page.data.detail.writingResult.durationText, '1 分 20 秒')
+    assert.equal(page.data.detail.writingResult.bandText, 'Band 7')
+    assert.equal(page.data.detail.writingResult.typedText, 'wrong words')
