+const path = require('node:path')
+const test = require('node:test')
+const vm = require('node:vm')
+
+const ROOT = path.resolve(__dirname, '..')
+const PRACTICES = ['writing_practice', 'question_type_practice']
+
+function loadPage(pageName, response = {}) {
+    let definition
+    const calls = { requests: [], navigation: [], clipboard: [], toasts: [], removed: [], cleared: [], intervals: 0, chooseImage: 0, recordings: 0 }
+    const app = { globalData: { baseUrl: 'https://studytracker.xin', guestMode: false, activeTimer: null } }
+    const recorder = { onStop() {}, start() { calls.recordings++ }, stop() {} }
+    const audio = { onPlay() {}, onPause() {}, onStop() {}, onEnded() {}, onError() {}, destroy() {} }
+    const sandbox = {
+        console: { log() {}, error() {} }, Date, Promise,
+        getApp: () => app,
+        Page: value => { definition = value },
+        setInterval: () => { calls.intervals++; return 99 },
+        clearInterval: id => calls.cleared.push(id),
+        setTimeout: () => 1,
+        clearTimeout() {},
+        require: name => {
+            if (name.endsWith('/utils/request.js')) return { request: async (url, options) => { calls.requests.push({ url, options }); return response } }
+            if (name.endsWith('/utils/demo-data.js')) return { buildStudentTasks: () => [], buildParentTaskDetail: () => ({}) }
+            if (name.endsWith('/utils/subscribe.js')) return { getSubscribeSummary: async () => ({}), requestTemplateSubscribe: async () => ({}) }
+            throw new Error(`Unexpected require ${name}`)
+        },
+        wx: {
+            navigateTo: options => calls.navigation.push(options.url),
+            redirectTo: options => calls.navigation.push(options.url),
+            getStorageSync: () => null,
+            setStorageSync() {},
+            removeStorageSync: key => calls.removed.push(key),
+            showToast: value => calls.toasts.push(value.title),
+            showLoading() {}, hideLoading() {}, stopPullDownRefresh() {},
+            showModal: async () => ({ confirm: true }),
+            getRecorderManager: () => recorder,
+            createInnerAudioContext: () => audio,
+            chooseImage: () => calls.chooseImage++,
+            setClipboardData: options => { calls.clipboard.push(options.data); options.success() }
+        }
+    }
+    const file = path.join(ROOT, `miniprogram/pages/${pageName}/index.js`)
+    vm.runInNewContext(fs.readFileSync(file, 'utf8'), sandbox, { filename: file })
+    const page = Object.assign({}, definition)
+    page.data = JSON.parse(JSON.stringify(definition.data))
+    page.setData = function (values, callback) { Object.assign(this.data, values); if (callback) callback() }
+    return { page, calls, app }
+}
+
+function practice(kind) {
+    return { kind, label: '网页练习', instruction: '请前往刷题网页练习，完成后结果会同步至家长端。', url: kind === 'writing_practice' ? 'https://studytracker.xin/writing/t1-001?task_id=42' : 'https://studytracker.xin/practice/question-types/task/42?token=synthetic' }
+}
+
+function task(kind, extra = {}) {
+    return { id: 42, date: '2026-10-26', task_name: '合成练习', module: '雅思写作', status: 'pending', planned_minutes: 20, web_practice: practice(kind), ...extra }
+}
+
+for (const kind of PRACTICES) {
+    test(`${kind}: home preserves website binding and opens instructions without generic timer`, async () => {
+        const { page, calls } = loadPage('student/home')
+        page.data.currentDate = '2026-10-26'
+        page.applyTaskData([task(kind)])
+        assert.equal(page.data.tasks[0].webPractice.url, practice(kind).url)
+        const event = { currentTarget: { dataset: { id: 42 } } }
+        page.goToTaskDetail(event)
+        await page.startTimer(event)
+        page.startSpellTask(event)
+        assert.deepEqual(calls.navigation, Array(3).fill('/pages/student/task/index?id=42'))
+        assert.equal(calls.requests.length, 0)
+        assert.equal(calls.intervals, 0)
+    })
+
+    test(`${kind}: detail copies the exact assignment and blocks ordinary upload / submit / timer`, async () => {
+        const source = task(kind)
+        const { page, calls, app } = loadPage('student/task', { ok: true, task: source })
+        page.data.taskId = 42
+        page.data.timerInterval = 77
+        app.globalData.activeTimer = { taskId: 42, startTime: Date.now() }
+        await page.fetchTaskDetail()
+        assert.equal(page.data.task.web_practice.url, source.web_practice.url)
+        assert.equal(app.globalData.activeTimer, null)
+        assert.equal(page.data.timerRunning, false)
+        assert.ok(calls.cleared.includes(77))
+        assert.equal(calls.navigation.length, 0)
+        page.copyWebPracticeLink()
+        assert.deepEqual(calls.clipboard, [source.web_practice.url])
+        page.chooseImage()
+        page.startRecord()
+        page.checkTimer()
+        await page.stopTimer()
+        await page.submitTask()
+        assert.equal(calls.chooseImage, 0)
+        assert.equal(calls.recordings, 0)
+        assert.equal(calls.intervals, 0)
+        assert.deepEqual(calls.requests.map(row => row.url), ['/miniprogram/student/tasks/42'])
+    })
+}
+
+test('home clears a saved generic timer when the assignment is a website task', () => {
+    const { page, app, calls } = loadPage('student/home')
+    app.globalData.activeTimer = { taskId: 42, startTime: Date.now(), sessionId: 9 }
+    page.data.timerInterval = 7
+    page.applyTaskData([task('writing_practice')])
+    page.restoreTimerIfNeeded()
+    assert.equal(app.globalData.activeTimer, null)
+    assert.equal(page.data.timerInterval, null)
+    assert.ok(calls.cleared.includes(7))
+    assert.equal(calls.intervals, 0)
+})
+
+test('missing website links remain guarded and future / expired task access stays read only', async () => {
+    for (const status of ['future', 'expired']) {
+        const source = task('writing_practice', { read_only: true, availability_status: status })
+        source.web_practice.url = null
+        const { page, calls } = loadPage('student/task', { ok: true, task: source })
+        page.data.taskId = 42
+        await page.fetchTaskDetail()
+        assert.equal(page.data.task.read_only, true)
+        page.copyWebPracticeLink()
+        await page.submitTask()
+        assert.equal(calls.clipboard.length, 0)
+        assert.equal(calls.requests.length, 1)
+        assert.ok(calls.toasts.includes('练习链接暂不可用，请联系老师'))
+    }
+})
+
+test('ordinary reading tasks keep their native practice route', () => {
+    const { page, calls } = loadPage('student/home')
+    page.applyTaskData([{ id: 7, module: '阅读', task_name: '剑雅阅读', status: 'pending', reading_test_id: 'ielts21_test1', reading_token: 'synthetic', planned_minutes: 20 }])
+    page.goToTaskDetail({ currentTarget: { dataset: { id: 7 } } })
+    assert.equal(calls.navigation[0], '/pages/student/reading/cambridge/index?taskId=7&token=synthetic')
+})
+
+test('parent typing results retain genuine zero accuracy, raw text and measured metrics', () => {
+    const { page } = loadPage('parent/task-detail')
+    page.applyDetail({ kind: 'writing_typing', accuracy: 0, summary: {}, items: [], writing_result: { band: '7', typed_word_count: 2, target_word_count: 200, speed_wpm: 1.5, duration_seconds: 80, completed_at: '2026-10-26T03:00:00', typed_text: 'wrong words' } })
+    assert.equal(page.data.detail.showAccuracy, true)
